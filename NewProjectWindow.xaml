<Window x:Class="DanteConfigEditor.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau projet expérimental"
        Width="920"
        Height="660"
        MinWidth="760"
        MinHeight="560"
        Loaded="Window_Loaded"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="HeadingTextBlock"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <Border Grid.Row="1"
                    Margin="0,8,0,14"
                    Padding="10"
                    Background="#3A2C12"
                    BorderBrush="#B7791F"
                    BorderThickness="1">
                <TextBlock x:Name="ExperimentalWarningTextBlock"
                           Foreground="#FDE68A"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>

        <ScrollViewer x:Name="FormScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Width="{Binding ViewportWidth, ElementName=FormScrollViewer}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.95*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>

                <GroupBox x:Name="ProjectGroupBox"
                          Header="Projet"
                          VerticalAlignment="Top">
                    <StackPanel>
                        <Label x:Name="PathLabel" Content="Fichier XML à créer" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathTextBox"
                                     IsReadOnly="True"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <Button x:Name="BrowsePathButton"
                                    Grid.Column="1"
                                    Content="Choisir"
                                    Margin="8,0,0,0"
                                    Click="BrowsePathButton_Click" />
                        </Grid>

                        <Label x:Name="ProjectNameLabel"
                               Margin="0,10,0,0"
                               Content="Nom du projet" />
                        <TextBox x:Name="ProjectNameTextBox" MaxLength="120" />
                        <Label x:Name="DescriptionLabel"
                               Margin="0,10,0,0"
                               Content="Description" />
                        <TextBox x:Name="DescriptionTextBox"
                                 Height="118"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="InitialDeviceGroupBox"
                          Grid.Column="2"
                          Header="Première machine"
                          VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label x:Name="SourceLabel" Content="Source" />
                                <ComboBox x:Name="SourceComboBox"
                                          MinWidth="220"
                                          SelectionChanged="SourceComboBox_SelectionChanged" />
                            </StackPanel>
                            <Button x:Name="OpenBanksButton"
                                    Grid.Column="1"
                                    Content="Gérer"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Margin="8,0,0,0"
                                    Click="OpenBanksButton_Click"
                                    ToolTip="Ouvre la gestion des banques de machines." />
                        </Grid>
                        <TextBlock x:Name="SourceHelpTextBlock"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource DialogMutedBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />

                        <Label x:Name="DeviceNameLabel"
                               Margin="0,10,0,0"
                               Content="Nom de la machine" />
                        <TextBox x:Name="DeviceNameTextBox" MaxLength="31" />

                        <Grid x:Name="CustomDeviceGrid" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <Label Content="TX" />
                                <TextBox x:Name="TxCountTextBox" Text="2" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <Label Content="RX" />
                                <TextBox x:Name="RxCountTextBox" Text="2" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Sample rate" />
                                <ComboBox x:Name="SampleRateComboBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,10,8,0">
                                <Label x:Name="EncodingLabel" Content="Encodage" />
                                <ComboBox x:Name="EncodingComboBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,8,0">
                                <Label x:Name="LatencyLabel" Content="Latence" />
                                <ComboBox x:Name="LatencyComboBox" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="TemplateLabelsGrid"
                              Margin="0,12,0,0"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <CheckBox x:Name="UseTemplateTxCheckBox"
                                          Content="Labels TX du modèle"
                                          IsChecked="True"
                                          Checked="TemplateLabelModeChanged"
                                          Unchecked="TemplateLabelModeChanged" />
                                <TextBox x:Name="TxPrefixTextBox" Text="TX" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <CheckBox x:Name="UseTemplateRxCheckBox"
                                          Content="Labels RX du modèle"
                                          IsChecked="True"
                                          Checked="TemplateLabelModeChanged"
                                          Unchecked="TemplateLabelModeChanged" />
                                <TextBox x:Name="RxPrefixTextBox" Text="RX" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="CreateButton"
                    Content="Créer le projet"
                    IsDefault="True"
                    Click="CreateButton_Click" />
            <Button x:Name="CancelButton"
                    Content="Annuler"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
