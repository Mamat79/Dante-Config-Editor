<Window x:Class="DanteConfigEditor.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau projet expérimental"
        Width="700"
        Height="720"
        MinWidth="590"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingTextBlock"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <Border Margin="0,8,0,14"
                    Padding="10"
                    Background="#3A2C12"
                    BorderBrush="#B7791F"
                    BorderThickness="1">
                <TextBlock x:Name="ExperimentalWarningTextBlock"
                           Foreground="#FDE68A"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <Label x:Name="PathLabel" Content="Fichier XML à créer" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathTextBox" IsReadOnly="True" />
                    <Button x:Name="BrowsePathButton"
                            Grid.Column="1"
                            Content="Choisir"
                            Margin="8,0,0,0"
                            Click="BrowsePathButton_Click" />
                </Grid>

                <Label x:Name="ProjectNameLabel" Margin="0,10,0,0" Content="Nom du projet" />
                <TextBox x:Name="ProjectNameTextBox" MaxLength="120" />
                <Label x:Name="DescriptionLabel" Margin="0,10,0,0" Content="Description" />
                <TextBox x:Name="DescriptionTextBox"
                         Height="70"
                         AcceptsReturn="True"
                         TextWrapping="Wrap" />

                <GroupBox x:Name="InitialDeviceGroupBox"
                          Margin="0,16,0,0"
                          Header="Première machine">
                    <StackPanel>
                        <Label x:Name="SourceLabel" Content="Source" />
                        <ComboBox x:Name="SourceComboBox"
                                  SelectionChanged="SourceComboBox_SelectionChanged" />
                        <Label x:Name="DeviceNameLabel"
                               Margin="0,10,0,0"
                               Content="Nom de la machine" />
                        <TextBox x:Name="DeviceNameTextBox" MaxLength="31" />

                        <Grid x:Name="CustomDeviceGrid" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <Label Content="TX" />
                                <TextBox x:Name="TxCountTextBox" Text="2" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <Label Content="RX" />
                                <TextBox x:Name="RxCountTextBox" Text="2" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Sample rate" />
                                <ComboBox x:Name="SampleRateComboBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,10,8,0">
                                <Label x:Name="EncodingLabel" Content="Encodage" />
                                <ComboBox x:Name="EncodingComboBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,8,0">
                                <Label x:Name="LatencyLabel" Content="Latence" />
                                <ComboBox x:Name="LatencyComboBox" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="TemplateLabelsGrid"
                              Margin="0,12,0,0"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <CheckBox x:Name="UseTemplateTxCheckBox"
                                          Content="Labels TX du modèle"
                                          IsChecked="True"
                                          Checked="TemplateLabelModeChanged"
                                          Unchecked="TemplateLabelModeChanged" />
                                <TextBox x:Name="TxPrefixTextBox" Text="TX" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <CheckBox x:Name="UseTemplateRxCheckBox"
                                          Content="Labels RX du modèle"
                                          IsChecked="True"
                                          Checked="TemplateLabelModeChanged"
                                          Unchecked="TemplateLabelModeChanged" />
                                <TextBox x:Name="RxPrefixTextBox" Text="RX" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="CreateButton"
                    Content="Créer le projet"
                    IsDefault="True"
                    Click="CreateButton_Click" />
            <Button x:Name="CancelButton"
                    Content="Annuler"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
