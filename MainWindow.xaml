<Window x:Class="DanteConfigEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DanteConfigEditor.Converters"
        Title="Dante Config Editor 2026.1 Beta"
        Width="1280"
        Height="820"
        MinWidth="1120"
        MinHeight="720"
        WindowState="Maximized"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        ToolTipService.InitialShowDelay="450"
        ToolTipService.ShowDuration="30000"
        Loaded="Window_Loaded">
    <Window.Resources>
        <converters:ChannelSeriesHandleVisibilityConverter x:Key="ChannelSeriesHandleVisibilityConverter" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#10141F" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#171D2B" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#202838" />
        <SolidColorBrush x:Key="TextBrush" Color="#F6F8FB" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#AAB4C5" />
        <SolidColorBrush x:Key="BorderLineBrush" Color="#334057" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F80ED" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#1D5FB8" />
        <SolidColorBrush x:Key="DangerBrush" Color="#D64545" />
        <SolidColorBrush x:Key="WarningBrush" Color="#D69E2E" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E9D62" />

        <DataTemplate x:Key="WrappingButtonContentTemplate">
            <TextBlock Text="{Binding}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="WrappingLabelContentTemplate">
            <TextBlock Text="{Binding}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="WrappingToolTipContentTemplate">
            <TextBlock Text="{Binding}"
                       MaxWidth="440"
                       TextWrapping="Wrap" />
        </DataTemplate>

        <!-- Styles globaux de l'application. Les couleurs changent via SetTheme dans MainWindow.xaml.cs. -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Padding" Value="0,8,0,4" />
            <Setter Property="ContentTemplate" Value="{StaticResource WrappingLabelContentTemplate}" />
        </Style>

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="ContentTemplate"
                    Value="{StaticResource WrappingToolTipContentTemplate}" />
        </Style>

        <DataTemplate x:Key="WhiteListTextTemplate">
            <TextBlock Text="{Binding}"
                       Foreground="#111827"
                       TextWrapping="NoWrap" />
        </DataTemplate>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ContentTemplate" Value="{StaticResource WrappingButtonContentTemplate}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ContentTemplate" Value="{StaticResource WrappingButtonContentTemplate}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelRevealButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ConfigurationSecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,0,6,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style TargetType="{x:Type Menu}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AtomicSequenceButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="#374151" />
            <Setter Property="BorderBrush" Value="#6B7280" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Commande d'entraînement dessinée en XAML, sans image externe. -->
        <Style x:Key="AtomicButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinWidth" Value="176" />
            <Setter Property="MinHeight" Value="126" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="AtomicAssembly"
                              MinWidth="170"
                              MinHeight="120"
                              ClipToBounds="True"
                              RenderTransformOrigin="0.5,0.5">
                            <Ellipse Width="112"
                                     Height="112"
                                     Fill="#C8CDD3"
                                     Stroke="#4B4F55"
                                     StrokeThickness="4">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="8"
                                                      Direction="270"
                                                      Opacity="0.75"
                                                      ShadowDepth="4"
                                                      Color="#000000" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="AtomicFace"
                                     Width="92"
                                     Height="92"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="#7F0B0B"
                                     StrokeThickness="3" />
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <TextBlock Text="3"
                                           Foreground="#FFF4F4"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock Text="FIRE"
                                           Foreground="White"
                                           FontSize="19"
                                           FontWeight="Black"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AtomicFace" Property="Stroke" Value="#FFD0D0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="AtomicAssembly" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="3" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="AtomicAssembly" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        </Style>

        <!-- Les listes restent volontairement en noir sur fond blanc, même en thème sombre. -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="ItemTemplate" Value="{StaticResource WhiteListTextTemplate}" />
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Padding" Value="8,5" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#E5E7EB" />
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E5E7EB" />
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemTemplate" Value="{StaticResource WhiteListTextTemplate}" />
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Padding" Value="8,5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F4F6" />
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E5E7EB" />
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="PanelListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>

        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,6,12,6" />
        </Style>

        <Style x:Key="PatchModeButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="ModeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ModeBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentDarkBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ModeBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="ModeBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Panel.ZIndex="1"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Margin="0,0,0,-1" />
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="10" />
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderLineBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre haute : actions de fichier, état du document et changement de thème. -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderLineBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Menu x:Name="ApplicationMenu"
                      Grid.Row="0"
                      Margin="-8,-6,-8,10"
                      Padding="2"
                      Background="Transparent"
                      Foreground="{DynamicResource TextBrush}"
                      AutomationProperties.Name="Menu principal">
                    <MenuItem Header="Fichier">
                        <MenuItem Header="Nouveau projet"
                                  InputGestureText="Ctrl+N"
                                  Click="NewProjectButton_Click" />
                        <MenuItem Header="Ouvrir un XML"
                                  InputGestureText="Ctrl+O"
                                  Click="OpenButton_Click" />
                        <MenuItem Header="Ajouter un XML au projet"
                                  IsEnabled="{Binding IsEnabled, ElementName=MergeXmlButton}"
                                  Click="MergeXmlButton_Click" />
                        <Separator />
                        <MenuItem Header="Enregistrer"
                                  InputGestureText="Ctrl+S"
                                  IsEnabled="{Binding IsEnabled, ElementName=SaveButton}"
                                  Click="SaveButton_Click" />
                        <MenuItem Header="Enregistrer sous"
                                  InputGestureText="Ctrl+Maj+S"
                                  IsEnabled="{Binding IsEnabled, ElementName=SaveAsButton}"
                                  Click="SaveAsButton_Click" />
                        <Separator />
                        <MenuItem Header="Quitter"
                                  InputGestureText="Alt+F4"
                                  Click="ExitMenuItem_Click" />
                    </MenuItem>

                    <MenuItem Header="Édition">
                        <MenuItem Header="Annuler"
                                  InputGestureText="Ctrl+Z"
                                  IsEnabled="{Binding IsEnabled, ElementName=UndoLastButton}"
                                  Click="UndoLastButton_Click" />
                        <MenuItem Header="Rétablir"
                                  InputGestureText="Ctrl+Y"
                                  IsEnabled="{Binding IsEnabled, ElementName=RedoButton}"
                                  Click="RedoButton_Click" />
                        <Separator />
                        <MenuItem Header="Annuler les changements non enregistrés"
                                  IsEnabled="{Binding IsEnabled, ElementName=RevertButton}"
                                  Click="RevertButton_Click" />
                    </MenuItem>

                    <MenuItem Header="Machines">
                        <MenuItem Header="Ouvrir la banque de machines"
                                  Click="OpenMachineBankButton_Click" />
                        <MenuItem Header="Ajouter depuis la banque"
                                  IsEnabled="{Binding IsEnabled, ElementName=AddDeviceFromBankButton}"
                                  Click="AddDeviceFromBankButton_Click" />
                        <Separator />
                        <MenuItem Header="Dupliquer la machine sélectionnée"
                                  IsEnabled="{Binding IsEnabled, ElementName=DuplicateDeviceButton}"
                                  Click="DuplicateDeviceButton_Click" />
                        <MenuItem Header="Enregistrer la machine dans la banque"
                                  IsEnabled="{Binding IsEnabled, ElementName=SaveDeviceToBankButton}"
                                  Click="SaveDeviceToBankButton_Click" />
                        <MenuItem Header="Supprimer la machine sélectionnée"
                                  IsEnabled="{Binding IsEnabled, ElementName=DeleteDeviceButton}"
                                  Click="DeleteDeviceButton_Click" />
                    </MenuItem>

                    <MenuItem Header="Affichage">
                        <MenuItem x:Name="NavigationMenuItem"
                                  Header="Navigation"
                                  IsCheckable="True"
                                  IsChecked="True"
                                  Click="NavigationMenuItem_Click" />
                        <MenuItem x:Name="InspectorMenuItem"
                                  Header="Inspecteur"
                                  IsCheckable="True"
                                  IsChecked="True"
                                  Click="InspectorMenuItem_Click" />
                        <MenuItem x:Name="SettingsPanelsMenuItem"
                                  Header="Réglages de la page Machines"
                                  IsCheckable="True"
                                  IsChecked="True"
                                  Click="ToggleConfigurationEditorsButton_Click" />
                        <Separator />
                        <MenuItem Header="Vue d'ensemble"
                                  Tag="Overview"
                                  Click="NavigateMenuItem_Click" />
                        <MenuItem Header="Machines"
                                  Tag="Machines"
                                  Click="NavigateMenuItem_Click" />
                        <MenuItem Header="Patch"
                                  Tag="Patch"
                                  Click="NavigateMenuItem_Click" />
                        <MenuItem Header="Banque de machines"
                                  Tag="DeviceLibrary"
                                  Click="NavigateMenuItem_Click" />
                        <MenuItem Header="Import / Export"
                                  Tag="ImportExport"
                                  Click="NavigateMenuItem_Click" />
                        <Separator />
                        <MenuItem x:Name="DarkThemeMenuItem"
                                  Header="Thème sombre"
                                  IsCheckable="True"
                                  IsChecked="True"
                                  Click="DarkThemeMenuItem_Click" />
                    </MenuItem>

                    <MenuItem Header="Outils">
                        <MenuItem Header="Centre de validation"
                                  Tag="Validation"
                                  Click="NavigateMenuItem_Click" />
                        <MenuItem Header="Historique"
                                  Tag="History"
                                  Click="NavigateMenuItem_Click" />
                        <MenuItem Header="Ouvrir les journaux"
                                  Click="OpenDiagnosticLogsButton_Click" />
                        <Separator />
                        <MenuItem Header="Atomic Bomb"
                                  Tag="AdvancedTools"
                                  Click="NavigateMenuItem_Click" />
                    </MenuItem>

                    <MenuItem Header="Aide">
                        <MenuItem Header="Démarrage rapide"
                                  Click="OpenQuickStartButton_Click" />
                        <MenuItem Header="Notice complète"
                                  Click="OpenFullNoticeButton_Click" />
                        <MenuItem Header="Notes de version"
                                  Click="OpenReleaseNotesMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="Projet GitHub"
                                  Click="OpenGitHubMenuItem_Click" />
                        <MenuItem Header="Soutenir DCE"
                                  Click="SupportDceButton_Click" />
                        <Separator />
                        <MenuItem Header="À propos de DCE"
                                  Click="AboutMenuItem_Click" />
                    </MenuItem>
                </Menu>

                <!-- Le titre et l'état restent sur une ligne bornée. Le chemin est
                     tronqué plutôt que replié, afin de ne jamais agrandir la barre. -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                         <TextBlock Text="Dante Config Editor 2026.1 Beta"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    TextWrapping="NoWrap" />
                        <TextBlock x:Name="FilePathTextBlock"
                                   Text="Aucun fichier ouvert"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <WrapPanel Margin="0,3,0,0">
                            <TextBlock x:Name="DocumentKindTextBlock"
                                       Text="XML Dante"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11"
                                       Margin="0,0,12,0"
                                       TextWrapping="NoWrap" />
                            <TextBlock x:Name="ProfileTextBlock"
                                       Text="Profil : non détecté"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11"
                                       Margin="0,0,12,0"
                                       TextWrapping="NoWrap" />
                            <TextBlock x:Name="LastSavedTextBlock"
                                       Text="Pas encore enregistré"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11"
                                       TextWrapping="NoWrap" />
                        </WrapPanel>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                         <TextBlock x:Name="DirtyStateTextBlock"
                                    Text="Non modifié"
                                    TextWrapping="NoWrap"
                                   Margin="0,0,14,8"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="LanguageLabelTextBlock"
                                   Text="Langue"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,8,8"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <ComboBox x:Name="LanguageComboBox"
                                  Width="105"
                                  Margin="0,0,8,8"
                                  AutomationProperties.Name="Langue de l'interface"
                                  SelectionChanged="LanguageComboBox_SelectionChanged" />
                        <ToggleButton x:Name="ThemeToggleButton"
                                       Content="Thème clair"
                                       AutomationProperties.Name="Changer le thème"
                                       Checked="ThemeToggleButton_Checked"
                                       Unchecked="ThemeToggleButton_Unchecked" />
                    </WrapPanel>
                </Grid>

                 <!-- Les commandes passent sur une seconde ligne si la fenêtre est
                      étroite, sans masquer les onglets ni le tableau des machines. -->
                 <WrapPanel Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Center">
                     <Button x:Name="NavigationToggleButton"
                             Content="Navigation"
                             Style="{StaticResource SecondaryButtonStyle}"
                             Visibility="Collapsed"
                             Click="NavigationToggleButton_Click"
                             ToolTip="Affiche ou masque la navigation principale." />
                      <Button x:Name="NewProjectButton"
                              Content="Nouveau"
                              Style="{StaticResource SecondaryButtonStyle}"
                              Click="NewProjectButton_Click"
                              ToolTip="Crée un nouveau projet hors ligne à partir d'une structure prise en charge." />
                      <Button x:Name="OpenXmlButton"
                              Content="Ouvrir"
                              Click="OpenButton_Click"
                              ToolTip="Charge un export XML Dante Controller." />
                     <Button x:Name="SaveButton"
                             Content="Enregistrer"
                             Click="SaveButton_Click"
                             ToolTip="Enregistre le projet courant. Pour un XML ouvert, une nouvelle destination est demandée." />
                     <Button x:Name="SaveAsButton"
                             Content="Enregistrer sous"
                             Style="{StaticResource SecondaryButtonStyle}"
                             Click="SaveAsButton_Click"
                             ToolTip="Enregistre sous un nouveau nom avec une sauvegarde de sécurité." />
                     <Button x:Name="UndoLastButton"
                             Content="Annuler"
                             Style="{StaticResource SecondaryButtonStyle}"
                             Click="UndoLastButton_Click"
                             IsEnabled="False"
                             ToolTip="Annule la dernière action réalisée dans cette session." />
                     <Button x:Name="RedoButton"
                             Content="Rétablir"
                             Style="{StaticResource SecondaryButtonStyle}"
                             Click="RedoButton_Click"
                             IsEnabled="False"
                             ToolTip="Rétablit la dernière action annulée lorsque la session 2026.1 le permet." />
                      <Button x:Name="OpenMachineBankButton"
                              Content="Banque de machines"
                              Style="{StaticResource SecondaryButtonStyle}"
                              Visibility="Collapsed"
                              Click="OpenMachineBankButton_Click"
                              ToolTip="Consulte, importe, exporte et administre les modèles de machines réutilisables." />
                      <Button x:Name="MergeXmlButton" Content="Ajouter XML au projet" Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" Click="MergeXmlButton_Click" ToolTip="Ajoute les machines d'un autre XML au projet ouvert. Les doublons peuvent être renommés." />
                     <Button x:Name="ActivateEditButton" Content="Activer l'édition" Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" Click="ActivateEditButton_Click" ToolTip="Autorise les modifications dans l'interface. La sauvegarde reste faite sous un nouveau nom." />
                     <Button x:Name="RevertButton" Content="Annuler les changements" Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" Click="RevertButton_Click" ToolTip="Recharge le fichier XML d'origine et abandonne les modifications non sauvegardées." />
                     <TextBlock Text="Recherche"
                                Foreground="{DynamicResource MutedTextBrush}"
                                VerticalAlignment="Center"
                                Margin="4,0,8,8"
                                TextWrapping="NoWrap" />
                     <TextBox x:Name="TopGlobalSearchTextBox"
                              Width="190"
                              MinHeight="34"
                              Margin="0,0,8,8"
                              VerticalContentAlignment="Center"
                              TextChanged="TopGlobalSearchTextBox_TextChanged"
                              AutomationProperties.Name="Recherche globale"
                              ToolTip="Recherche les machines, canaux et subscriptions du projet." />
                     <Button x:Name="ValidationSummaryButton"
                             Content="Validation"
                             Style="{StaticResource SecondaryButtonStyle}"
                             Click="ValidationSummaryButton_Click"
                             ToolTip="Ouvre le centre de validation." />
                     <Button x:Name="InspectorToggleButton"
                             Content="Inspecteur"
                             Style="{StaticResource SecondaryButtonStyle}"
                             Visibility="Collapsed"
                             Click="InspectorToggleButton_Click"
                             ToolTip="Affiche ou masque l'inspecteur contextuel." />
                     <ComboBox x:Name="RecentFilesComboBox"
                               Width="230"
                               Margin="0,0,8,8"
                               Visibility="Collapsed"
                               AutomationProperties.Name="Fichiers XML récents"
                               ToolTip="Liste les derniers XML ouverts." />
                     <Button Content="Ouvrir récent" Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" Click="OpenRecentButton_Click" ToolTip="Ouvre le fichier sélectionné dans la liste récente." />
                </WrapPanel>
            </Grid>
        </Border>

        <Border x:Name="SupportReminderBorder"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8"
                AutomationProperties.Name="Rappel facultatif pour soutenir DCE">
            <DockPanel LastChildFill="True">
                <WrapPanel DockPanel.Dock="Right" Margin="18,0,0,0">
                    <Button x:Name="SupportReminderOpenButton"
                            Content="Soutenir DCE"
                            Click="SupportReminderOpenButton_Click"
                            ToolTip="Affiche les moyens facultatifs de soutenir le projet." />
                    <Button x:Name="SupportReminderLaterButton"
                            Content="Pas maintenant"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SupportReminderLaterButton_Click"
                            ToolTip="Masque ce rappel pendant 20 lancements." />
                    <Button x:Name="SupportReminderNeverButton"
                            Content="Ne plus afficher"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SupportReminderNeverButton_Click"
                            ToolTip="Désactive définitivement ce rappel local." />
                </WrapPanel>
                <TextBlock x:Name="SupportReminderTextBlock"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="DCE vous fait gagner du temps ? Vous pouvez soutenir son développement, sans aucune obligation." />
            </DockPanel>
        </Border>

        <!-- Shell 2026.1 : navigation, espace de travail et inspecteur contextuel. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="216" MinWidth="0" />
                <ColumnDefinition x:Name="NavigationSplitterColumn" Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorSplitterColumn" Width="44" />
                <ColumnDefinition x:Name="InspectorColumn" Width="292" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="NavigationBorder"
                    Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="16">
                <DockPanel x:Name="NavigationPanel">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Navigation"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Margin="0,0,0,12">
                            <RadioButton x:Name="HomeNavigationButton"
                                         Content="Projet"
                                         Tag="Home"
                                         GroupName="ShellNavigation"
                                         Style="{StaticResource ShellNavigationRadioStyle}"
                                         Checked="NavigationButton_Checked"
                                         AutomationProperties.HelpText="Ouvre l'accueil et les fichiers récents." />
                            <RadioButton x:Name="OverviewNavigationButton"
                                         Content="Vue d'ensemble"
                                         Tag="Overview"
                                         GroupName="ShellNavigation"
                                         Style="{StaticResource ShellNavigationRadioStyle}"
                                         Checked="NavigationButton_Checked" />
                            <RadioButton x:Name="MachinesNavigationButton"
                                         Content="Machines"
                                         Tag="Machines"
                                         GroupName="ShellNavigation"
                                         Style="{StaticResource ShellNavigationRadioStyle}"
                                         Checked="NavigationButton_Checked" />
                            <RadioButton x:Name="PatchNavigationButton"
                                         Content="Patch"
                                         Tag="Patch"
                                         GroupName="ShellNavigation"
                                         Style="{StaticResource ShellNavigationRadioStyle}"
                                         Checked="NavigationButton_Checked" />
                            <RadioButton x:Name="SynopticNavigationButton"
                                         Content="Synoptique"
                                         Tag="Synoptic"
                                         GroupName="ShellNavigation"
                                         Style="{StaticResource ShellNavigationRadioStyle}"
                                         Visibility="Collapsed"
                                         Checked="NavigationButton_Checked" />
                            <RadioButton x:Name="DeviceLibraryNavigationButton"
                                         Content="Banque de machines"
                                         Tag="DeviceLibrary"
                                         GroupName="ShellNavigation"
                                         Style="{StaticResource ShellNavigationRadioStyle}"
                                         Visibility="Collapsed"
                                         Checked="NavigationButton_Checked" />
                            <RadioButton x:Name="ImportExportNavigationButton"
                                         Content="Import / Export"
                                         Tag="ImportExport"
                                         GroupName="ShellNavigation"
                                         Style="{StaticResource ShellNavigationRadioStyle}"
                                         Checked="NavigationButton_Checked" />
                            <RadioButton x:Name="ValidationNavigationButton"
                                         Content="Centre de validation"
                                         Tag="Validation"
                                         GroupName="ShellNavigation"
                                         Style="{StaticResource ShellNavigationRadioStyle}"
                                         Checked="NavigationButton_Checked" />
                            <RadioButton x:Name="HistoryNavigationButton"
                                         Content="Historique"
                                         Tag="History"
                                         GroupName="ShellNavigation"
                                         Style="{StaticResource ShellNavigationRadioStyle}"
                                         Checked="NavigationButton_Checked" />
                            <RadioButton x:Name="AdvancedToolsNavigationButton"
                                         Content="Outils avancés"
                                         Tag="AdvancedTools"
                                         GroupName="ShellNavigation"
                                         Style="{StaticResource ShellNavigationRadioStyle}"
                                         Checked="NavigationButton_Checked" />
                        </StackPanel>

                        <Separator Margin="0,0,0,10" />
                        <TextBlock Text="Projet" FontWeight="SemiBold" FontSize="15" />
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderLineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,10,0,0">
                        <TextBlock x:Name="ProjectSummaryTextBlock"
                                   Text="Chargez un fichier XML pour commencer."
                                    Foreground="{DynamicResource MutedTextBrush}" />
                        </Border>

                        <!-- Les alertes restent dans le rail de navigation afin de ne pas réduire
                             la hauteur disponible pour les réglages et le tableau des machines. -->
                        <Border x:Name="ImportantWarningsBorder"
                                Background="#FEF2F2"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="2"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,12,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="POINTS À VÉRIFIER"
                                           Foreground="#991B1B"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Margin="0,0,0,6" />
                                <ScrollViewer MaxHeight="115"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="ImportantWarningsTextBlock"
                                               Foreground="#991B1B"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </ScrollViewer>
                                <Button Content="Voir les machines"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Foreground="#991B1B"
                                        Background="#FEE2E2"
                                        BorderBrush="#FCA5A5"
                                        Padding="10,5"
                                        Margin="0,8,0,0"
                                        Click="ImportantWarningsDetailsButton_Click" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Recherche"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,6" />
                        <TextBox x:Name="GlobalSearchTextBox"
                                 TextChanged="GlobalSearchTextBox_TextChanged" />
                        <Grid Height="135" Margin="0,8,0,0">
                            <ListBox x:Name="GlobalSearchListBox"
                                     Style="{StaticResource PanelListBoxStyle}"
                                     ItemContainerStyle="{StaticResource PanelListBoxItemStyle}"
                                     SelectionChanged="GlobalSearchListBox_SelectionChanged" />
                            <TextBlock x:Name="GlobalSearchHintTextBlock"
                                       Text="Tapez au moins 2 caractères pour chercher"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="10"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderLineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <TextBlock Text="Mode hors ligne : l'application modifie uniquement les fichiers XML chargés. Elle ne se connecte pas au réseau Dante." 
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </Border>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="NavigationSplitter"
                          Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderLineBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <Button x:Name="NavigationRevealButton"
                    Grid.Column="1"
                    Content="&lt;"
                    Visibility="Visible"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Panel.ZIndex="2"
                    Style="{StaticResource PanelRevealButtonStyle}"
                    Click="NavigationToggleButton_Click"
                    ToolTip="Masquer navigation"
                    AutomationProperties.Name="Masquer navigation"
                    AutomationProperties.HelpText="Masque ou rouvre la navigation principale." />

             <TabControl x:Name="MainTabs"
                         Grid.Column="2"
                         Margin="12"
                         Style="{StaticResource ShellWorkspaceTabControlStyle}"
                         SelectionChanged="MainTabs_SelectionChanged">
                <TabItem x:Name="ConfigurationTab" Header="Configuration">
                    <Grid Margin="0,6,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="ConfigurationEditorsRow" Height="8*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="DeviceListRow" Height="0" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <WrapPanel DockPanel.Dock="Right"
                                               HorizontalAlignment="Right">
                                        <Button x:Name="AddDeviceFromBankButton"
                                                Content="Ajouter depuis la banque"
                                                Click="AddDeviceFromBankButton_Click"
                                                ToolTip="Ouvre la vue globale des banques et ajoute une nouvelle machine indépendante au projet." />
                                        <Button x:Name="ManageMachineBankButton"
                                                Content="Gérer les banques"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="ManageMachineBankButton_Click"
                                                ToolTip="Ouvre la vue globale pour rechercher, filtrer et administrer les banques de machines." />
                                    </WrapPanel>
                                    <TextBlock Text="Machines"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0" />
                                </DockPanel>
                            </Border>

                            <Grid x:Name="ConfigurationEditorsRegion" Grid.Row="1">
                                <ScrollViewer x:Name="ConfigurationEditorsScrollViewer"
                                              Margin="0,0,0,8"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="ConfigurationEditorsGrid">
                                <Grid.Resources>
                                    <Style TargetType="{x:Type Button}"
                                           BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Padding" Value="9,5" />
                                        <Setter Property="MinHeight" Value="30" />
                                        <Setter Property="Margin" Value="0,0,6,5" />
                                        <Setter Property="FontSize" Value="11" />
                                    </Style>
                                    <Style TargetType="{x:Type Label}"
                                           BasedOn="{StaticResource {x:Type Label}}">
                                        <Setter Property="Padding" Value="0,5,0,2" />
                                    </Style>
                                    <Style TargetType="{x:Type CheckBox}"
                                           BasedOn="{StaticResource {x:Type CheckBox}}">
                                        <Setter Property="Margin" Value="0,4,0,4" />
                                    </Style>
                                    <Style TargetType="{x:Type RadioButton}"
                                           BasedOn="{StaticResource {x:Type RadioButton}}">
                                        <Setter Property="Margin" Value="0,4,10,4" />
                                    </Style>
                                    <Style TargetType="{x:Type TextBox}"
                                           BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Padding" Value="7,4" />
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="1.05*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,0,0,12" />
                                <Separator Grid.Column="2"
                                           Panel.ZIndex="1"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Stretch"
                                           Width="1"
                                           Margin="0,12,0,24"
                                           Background="{DynamicResource BorderLineBrush}" />

                                <GroupBox Grid.Column="1"
                                          Header="Machine sélectionnée"
                                          BorderThickness="0"
                                          Margin="4,4,8,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.ColumnSpan="2">
                                            <Label Content="Machine" />
                                            <ComboBox x:Name="DeviceComboBox" SelectionChanged="DeviceComboBox_SelectionChanged" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Margin="0,8,8,0">
                                            <Label Content="Nouveau nom" />
                                            <TextBox x:Name="NewNameTextBox" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,8,0,0">
                                            <Label Content="Mode réseau" />
                                            <WrapPanel>
                                                <RadioButton x:Name="RedundantRadioButton" Content="Redondant" GroupName="NetworkMode" />
                                                <RadioButton x:Name="DaisychainRadioButton" Content="Daisychain" GroupName="NetworkMode" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Margin="0,8,8,0">
                                            <Label Content="Latence unicast" />
                                            <ComboBox x:Name="LatencyComboBox" ToolTip="La valeur affichée est en ms. Le XML conserve la valeur brute Dante." />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,8,0,0">
                                            <Label Content="Horloge" />
                                            <CheckBox x:Name="PreferredMasterCheckBox" Content="Preferred master" />
                                        </StackPanel>

                                        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="ApplyDeviceSettingsButton"
                                                    Content="Appliquer les paramètres"
                                                    HorizontalAlignment="Stretch"
                                                    Click="ApplyDeviceSettingsButton_Click"
                                                    ToolTip="Applique en une seule fois le nom, le mode réseau, la latence et le statut Preferred master." />
                                            <Button x:Name="OpenDeviceDetailsButton"
                                                    Grid.Column="1"
                                                    Content="Détail machine"
                                                    Style="{StaticResource ConfigurationSecondaryButtonStyle}"
                                                    ToolTip="Ouvre tous les réglages de la machine : IP automatique ou fixe, formats audio et noms des canaux."
                                                    Click="OpenDeviceDetailsButton_Click" />
                                        </Grid>

                                        <UniformGrid x:Name="DevicePatchActionGrid"
                                                     Grid.Row="4"
                                                     Grid.ColumnSpan="2"
                                                     Columns="2" Margin="0,2,0,0">
                                            <Button x:Name="ResetDeviceRxPatchesButton"
                                                    Content="Reset RX"
                                                    Style="{StaticResource ConfigurationSecondaryButtonStyle}"
                                                    ToolTip="Déconnecte seulement les entrées RX de la machine sélectionnée."
                                                    Click="ResetDeviceRxPatchesButton_Click" />
                                            <Button x:Name="ResetDeviceTxPatchesButton"
                                                    Content="Reset TX"
                                                    Style="{StaticResource ConfigurationSecondaryButtonStyle}"
                                                    ToolTip="Supprime seulement les patchs qui utilisent les TX de la machine sélectionnée."
                                                    Click="ResetDeviceTxPatchesButton_Click" />
                                            <Button x:Name="ResetDevicePatchesButton"
                                                    Content="Reset RX/TX"
                                                    Style="{StaticResource ConfigurationSecondaryButtonStyle}"
                                                    ToolTip="Déconnecte les RX de la machine et supprime les patchs qui utilisent ses TX."
                                                    Click="ResetDevicePatchesButton_Click" />
                                            <Button x:Name="DeleteDeviceButton"
                                                    Content="Supprimer"
                                                    Style="{StaticResource ConfigurationSecondaryButtonStyle}"
                                                    ToolTip="Supprime la machine et nettoie les patchs qui lui sont associés."
                                                    Click="DeleteDeviceButton_Click" />
                                         </UniformGrid>

                                         <UniformGrid Grid.Row="5"
                                                      Grid.ColumnSpan="2"
                                                      Columns="2"
                                                      Margin="0,2,0,0">
                                             <Button x:Name="DuplicateDeviceButton"
                                                     Content="Dupliquer"
                                                     Style="{StaticResource ConfigurationSecondaryButtonStyle}"
                                                     ToolTip="Crée un rôle générique indépendant sans recopier l'identité matérielle."
                                                     Click="DuplicateDeviceButton_Click" />
                                             <Button x:Name="SaveDeviceToBankButton"
                                                     Content="Enregistrer dans la banque"
                                                     Style="{StaticResource ConfigurationSecondaryButtonStyle}"
                                                     ToolTip="Crée un modèle réutilisable et partageable à partir de cette machine."
                                                     Click="SaveDeviceToBankButton_Click" />
                                         </UniformGrid>
                                         <TextBlock x:Name="DeviceCapabilityHintTextBlock"
                                                    Grid.Row="6"
                                                    Grid.ColumnSpan="2"
                                                    Visibility="Collapsed"
                                                    Margin="0,6,0,0"
                                                    Foreground="{DynamicResource WarningBrush}"
                                                    FontSize="11" />
                                     </Grid>
                                 </GroupBox>

                                <GroupBox Grid.Column="2"
                                          Header="Canaux de la machine"
                                          BorderThickness="0"
                                          Margin="8,4,4,16">
                                    <StackPanel>
                                        <Label Content="Canal à renommer" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ChannelKindComboBox"
                                                      SelectionChanged="ChannelSelector_Changed"
                                                      Margin="0,0,8,0" />
                                            <ComboBox x:Name="ChannelComboBox"
                                                      Grid.Column="1"
                                                      SelectionChanged="ChannelComboBox_SelectionChanged" />
                                        </Grid>

                                        <Label Content="Nouveau nom de canal" />
                                        <TextBox x:Name="NewChannelNameTextBox" />
                                        <WrapPanel>
                                            <Button x:Name="RenameChannelButton" Content="Renommer le canal" Click="RenameChannelButton_Click" />
                                            <Button x:Name="ResetDeviceChannelsButton" Content="Réinitialiser les canaux de la machine" Style="{StaticResource SecondaryButtonStyle}" Click="ResetDeviceChannelsButton_Click" />
                                        </WrapPanel>
                                        <Separator Margin="0,6,0,6" />
                                        <TextBlock Text="Renommage en série" FontWeight="SemiBold" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0">
                                                <Label Content="Canal début" />
                                                <ComboBox x:Name="BatchRenameStartChannelComboBox" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <Label Content="Canal fin" />
                                                <ComboBox x:Name="BatchRenameEndChannelComboBox" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0">
                                                <Label Content="Préfixe" />
                                                <TextBox x:Name="BatchRenamePrefixTextBox"
                                                         ToolTip="Préfixe simple : HF donnera HF 01, HF 02. Modèle avancé : HF {00}, IN-{device}-{000}, ou {n} sans zéro." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <Label Content="Numéro" />
                                                <TextBox x:Name="BatchRenameStartTextBox" Text="1" />
                                            </StackPanel>
                                        </Grid>
                                        <Button x:Name="BatchRenameButton" Content="Renommer la série" Style="{StaticResource ConfigurationSecondaryButtonStyle}" Click="BatchRenameButton_Click" />
                                    </StackPanel>
                                </GroupBox>

                                <Grid Grid.Column="0" Margin="0,0,12,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <GroupBox Header="Actions globales"
                                              VerticalAlignment="Stretch">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TabControl Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderLineBrush}"
                                                        Foreground="{DynamicResource TextBrush}">
                                            <TabItem Header="Réseau / audio" Padding="6,4">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Margin="0,0,8,0">
                                                        <WrapPanel>
                                                            <RadioButton x:Name="GlobalRedundantRadioButton" Content="Redondant" GroupName="GlobalNetworkMode" />
                                                            <RadioButton x:Name="GlobalDaisychainRadioButton" Content="Daisychain" GroupName="GlobalNetworkMode" />
                                                        </WrapPanel>
                                                        <Button x:Name="ApplyAllNetworkButton" Content="Appliquer le mode à tous" Click="ApplyAllNetworkButton_Click" ToolTip="Applique le mode réseau à la cible choisie, en ignorant les machines verrouillées." />

                                                        <Label Content="Latence globale" />
                                                        <ComboBox x:Name="GlobalLatencyComboBox" ToolTip="La valeur affichée est en ms. Le XML conserve la valeur brute Dante." />
                                                        <Button x:Name="ApplyAllLatencyButton" Content="Appliquer la latence à tous" Click="ApplyAllLatencyButton_Click" ToolTip="Applique la latence à la cible choisie après prévisualisation." />
                                                        <Button x:Name="ResetAllChannelsButton" Content="Réinitialiser tous les canaux" Style="{StaticResource ConfigurationSecondaryButtonStyle}" Click="ResetAllChannelsButton_Click" ToolTip="Réinitialise les noms de canaux TX/RX de la cible choisie, en respectant les verrous." />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <Label Content="Sample rate globale" />
                                                        <ComboBox x:Name="GlobalSampleRateComboBox" IsEditable="True" />
                                                        <Button x:Name="ApplyAllSampleRateButton" Content="Appliquer la fréquence à tous" Click="ApplyAllSampleRateButton_Click" ToolTip="Applique la sample rate à la cible choisie. À vérifier avant import Dante." />

                                                        <Label Content="Bits par échantillon globaux" />
                                                        <ComboBox x:Name="GlobalEncodingComboBox" IsEditable="True" />
                                                        <Button x:Name="ApplyAllEncodingButton" Content="Appliquer les bits à tous" Click="ApplyAllEncodingButton_Click" ToolTip="Applique les bits par échantillon à la cible choisie." />
                                                    </StackPanel>
                                                </Grid>
                                            </TabItem>

                                            <TabItem Header="IP" Padding="6,4">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Margin="0,0,8,0">
                                                        <Label Content="Préfixe IP" />
                                                        <TextBox x:Name="GlobalIpPrefixTextBox" Text="192.168.1" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <Label Content="Premier numéro" />
                                                        <TextBox x:Name="GlobalIpStartTextBox" Text="10" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Margin="0,8,8,0">
                                                        <Label Content="Masque" />
                                                        <TextBox x:Name="GlobalIpNetmaskTextBox" Text="255.255.255.0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                                        <Label Content="Passerelle" />
                                                        <TextBox x:Name="GlobalIpGatewayTextBox" Text="0.0.0.0" />
                                                    </StackPanel>

                                                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                        <Button x:Name="ApplyAllIpStaticButton" Content="Fixer les IP en série" Click="ApplyAllIpStaticButton_Click" ToolTip="Attribue des IP fixes en série aux machines de la cible qui ont une interface IPv4 modifiable." />
                                                        <Button x:Name="ApplyAllIpAutoButton" Content="Mettre toutes les IP en automatique" Style="{StaticResource SecondaryButtonStyle}" Click="ApplyAllIpAutoButton_Click" ToolTip="Repasse les IP reconnues en automatique pour la cible choisie." />
                                                    </WrapPanel>
                                                </Grid>
                                            </TabItem>

                                            <TabItem Header="Profils" Padding="6,4">
                                                <StackPanel Margin="0,8,0,0">
                                                    <Label Content="Profil rapide" />
                                                    <ComboBox x:Name="QuickProfileComboBox" />
                                                    <Button x:Name="ApplyQuickProfileButton"
                                                            Content="Appliquer le profil à la cible"
                                                            Margin="0,10,0,0"
                                                            Click="ApplyQuickProfileButton_Click"
                                                            ToolTip="Applique en une seule action les formats audio, la latence, l'IP automatique et éventuellement le mode réseau du profil à la cible choisie." />
                                                </StackPanel>
                                            </TabItem>

                                            <TabItem Header="Horloge" Padding="6,4">
                                                <StackPanel Margin="0,8,0,0">
                                                    <Label Content="Preferred Master à conserver" />
                                                    <ComboBox x:Name="ExclusivePreferredMasterComboBox"
                                                              ToolTip="Choisissez la seule machine qui restera Preferred Master." />
                                                    <Button x:Name="ApplyExclusivePreferredMasterButton"
                                                            Content="Conserver un seul Preferred Master"
                                                            Margin="0,10,0,0"
                                                            Click="ApplyExclusivePreferredMasterButton_Click"
                                                            ToolTip="Active le Preferred Master sur la machine choisie et le désactive sur toutes les autres." />
                                                </StackPanel>
                                            </TabItem>
                                            </TabControl>
                                            <Border Grid.Row="1"
                                                    Margin="0,4,0,0"
                                                    Padding="5,3"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderLineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Liste rapide"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold" />
                                                    <ComboBox x:Name="QuickListComboBox"
                                                              Grid.Column="1"
                                                              SelectedIndex="0"
                                                              MinWidth="120"
                                                              MinHeight="28"
                                                              Margin="0,0,8,0"
                                                              ToolTip="Choisissez l'information de contrôle à afficher.">
                                                        <ComboBoxItem Content="Redondants" Tag="redundant" />
                                                        <ComboBoxItem Content="Daisychain" Tag="daisychain" />
                                                        <ComboBoxItem Content="Latences" Tag="latencies" />
                                                        <ComboBoxItem Content="Sample rates" Tag="sample-rates" />
                                                        <ComboBoxItem Content="Bits" Tag="bits" />
                                                        <ComboBoxItem Content="IP fixes" Tag="static-ips" />
                                                        <ComboBoxItem Content="Preferred masters" Tag="preferred-masters" />
                                                    </ComboBox>
                                                    <Button Grid.Column="2"
                                                            Content="Afficher"
                                                            MinHeight="28"
                                                            Padding="9,4"
                                                            Margin="0"
                                                            Style="{StaticResource ConfigurationSecondaryButtonStyle}"
                                                            Click="ShowQuickListButton_Click"
                                                            ToolTip="Affiche la liste de contrôle sélectionnée." />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                                </ScrollViewer>

                            <Button x:Name="ToggleConfigurationEditorsButton"
                                    Panel.ZIndex="5"
                                    Content="&#x25B2;"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Visibility="Collapsed"
                                    Width="48"
                                    MinWidth="48"
                                    Height="26"
                                    Padding="8,2"
                                    Margin="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Click="ToggleConfigurationEditorsButton_Click"
                                    ToolTip="Masquer les réglages"
                                    AutomationProperties.Name="Masquer les réglages"
                                    AutomationProperties.HelpText="Masque ou rouvre les panneaux de réglage pour agrandir le tableau des machines." />
                            </Grid>

                            <Border Grid.Row="2"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ToggleDeviceListButton"
                                            Grid.Column="1"
                                            Content="&#x25BC;"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="48"
                                            MinWidth="48"
                                            Height="26"
                                            MinHeight="26"
                                            Padding="8,2"
                                            Margin="0"
                                            FontSize="12"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Click="ToggleDeviceListButton_Click"
                                            ToolTip="Afficher la liste des machines"
                                            AutomationProperties.Name="Afficher la liste des machines"
                                            AutomationProperties.HelpText="Affiche ou masque la liste et les filtres des machines." />
                                    <TextBlock x:Name="DeviceListTitleTextBlock"
                                               Grid.Column="0"
                                               Text="Liste des machines"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="6,0,12,0" />
                                </Grid>
                            </Border>

                            <Grid x:Name="DeviceListPanel"
                                  Grid.Row="3"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="ShowDeviceChangesButton"
                                                Content="Avant / après"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="ShowDeviceChangesButton_Click"
                                                ToolTip="Affiche toutes les différences de machines, canaux et patchs depuis l'ouverture du XML." />
                                    </StackPanel>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Label Content="Filtre machines"
                                               Margin="0,0,6,8"
                                               VerticalAlignment="Center"
                                               ToolTip="Filtre seulement le tableau des machines, sans modifier le XML." />
                                        <ComboBox x:Name="DeviceFilterComboBox"
                                                  Width="190"
                                                  Margin="0,0,12,8"
                                                  SelectionChanged="DeviceFilter_SelectionChanged"
                                                  ToolTip="Affiche rapidement les machines en IP fixe, preferred master, redondantes, daisychain, sans TX/RX ou avec formats différents." />
                                        <Label Content="Cible actions"
                                               Margin="0,0,6,8"
                                               VerticalAlignment="Center"
                                               ToolTip="Détermine quelles machines seront touchées par les actions globales." />
                                        <ComboBox x:Name="TargetScopeComboBox"
                                                  Width="230"
                                                  Margin="0,0,12,8"
                                                  ToolTip="Choisissez si les actions globales s'appliquent à toutes les machines non verrouillées, à la sélection ou au filtre affiché." />
                                        <Button Content="Sélectionner visibles"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="SelectVisibleDevicesButton_Click"
                                                ToolTip="Sélectionne toutes les machines actuellement visibles dans le tableau." />
                                        <Button Content="Effacer sélection"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="ClearDeviceSelectionButton_Click"
                                                ToolTip="Vide la sélection multiple du tableau." />
                                        <Button Content="Verrouiller sélection"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="LockSelectedDevicesButton_Click"
                                                ToolTip="Les machines verrouillées sont ignorées par les actions globales." />
                                        <Button Content="Déverrouiller sélection"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="UnlockSelectedDevicesButton_Click"
                                                ToolTip="Retire le verrou des machines sélectionnées." />
                                    </WrapPanel>
                                </DockPanel>
                            </Border>

                            <DataGrid x:Name="DeviceGrid"
                                      Grid.Row="1"
                                      MinHeight="160"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      SelectionChanged="DeviceGrid_SelectionChanged"
                                      MouseDoubleClick="DeviceGrid_MouseDoubleClick">
                                <DataGrid.RowStyle>
                                    <Style TargetType="{x:Type DataGridRow}">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                <Setter Property="Background" Value="#3B2F12" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Lock" Width="0.55*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsLocked, Mode=OneWay}"
                                                          HorizontalAlignment="Center"
                                                          Click="DeviceLockCheckBox_Click"
                                                          ToolTip="Verrouille cette machine pour que les actions globales ne la modifient pas." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="Friendly name" Binding="{Binding FriendlyName}" Width="2*" />
                                    <DataGridTextColumn Header="Réseau" Binding="{Binding NetworkMode}" Width="*" />
                                    <DataGridTextColumn Header="Latence" Binding="{Binding LatencyDisplay}" Width="*" />
                                    <DataGridTextColumn Header="Sample rate" Binding="{Binding SampleRateDisplay}" Width="*" />
                                    <DataGridTextColumn Header="Bits" Binding="{Binding EncodingDisplay}" Width="0.7*" />
                                    <DataGridTextColumn Header="IP" Binding="{Binding IpModeDisplay}" Width="1.2*" />
                                    <DataGridTemplateColumn Header="Preferred" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding PreferredMaster, Mode=OneWay}"
                                                          IsEnabled="{Binding SupportsPreferredMaster}"
                                                          HorizontalAlignment="Center"
                                                          ToolTip="{Binding PreferredMasterToolTip}"
                                                          Click="DevicePreferredMasterCheckBox_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="TX" Binding="{Binding TxCount}" Width="0.7*" />
                                    <DataGridTextColumn Header="RX" Binding="{Binding RxCount}" Width="0.7*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ClassicPatchTab" Header="Patch">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderLineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,10">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,6"
                                        Visibility="Collapsed"
                                        Margin="10,0,0,0">
                                    <TextBlock x:Name="UnifiedPatchPendingCountTextBlock"
                                               Text="0 modification en attente"
                                               Visibility="Collapsed"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Center"
                                               AutomationProperties.Name="Compteur des modifications Patch en attente" />
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="PatchMatrixModeButton"
                                                     Content="Matrice"
                                                     Tag="Matrix"
                                                     GroupName="UnifiedPatchModes"
                                                     Style="{StaticResource PatchModeButtonStyle}"
                                                     IsChecked="True"
                                                     Checked="PatchWorkspaceModeButton_Checked"
                                                     ToolTip="Affiche la matrice RX/TX. Un clic applique directement le patch."
                                                     AutomationProperties.Name="Mode Matrice du Patch" />
                                        <RadioButton x:Name="PatchEasyModeButton"
                                                     Content="Easy patch"
                                                     Tag="Easy"
                                                     GroupName="UnifiedPatchModes"
                                                     Style="{StaticResource PatchModeButtonStyle}"
                                                     Checked="PatchWorkspaceModeButton_Checked"
                                                     ToolTip="Affecte des sélections et des plages RX/TX dans le même moteur de Patch."
                                                     AutomationProperties.Name="Mode Easy Patch" />
                                        <RadioButton x:Name="PatchListModeButton"
                                                     Content="Liste RX vers TX"
                                                     Tag="List"
                                                     GroupName="UnifiedPatchModes"
                                                     Style="{StaticResource PatchModeButtonStyle}"
                                                     Checked="PatchWorkspaceModeButton_Checked"
                                                     ToolTip="Affiche chaque RX et sa source TX courante."
                                                     AutomationProperties.Name="Mode Liste RX vers TX" />
                                        <RadioButton x:Name="PatchPerDeviceModeButton"
                                                     Content="Par machine"
                                                     Tag="Device"
                                                     GroupName="UnifiedPatchModes"
                                                     Style="{StaticResource PatchModeButtonStyle}"
                                                     Visibility="Collapsed"
                                                     Checked="PatchWorkspaceModeButton_Checked"
                                                     ToolTip="Filtre la liste Patch sur la machine actuellement sélectionnée."
                                                     AutomationProperties.Name="Mode Patch par machine" />
                                        <RadioButton x:Name="PatchPendingModeButton"
                                                     Content="Modifications en attente"
                                                     Tag="Pending"
                                                     GroupName="UnifiedPatchModes"
                                                     Style="{StaticResource PatchModeButtonStyle}"
                                                     Visibility="Collapsed"
                                                     Checked="PatchWorkspaceModeButton_Checked"
                                                     ToolTip="Contrôle les lots préparés avant leur application atomique."
                                                     AutomationProperties.Name="Modifications Patch en attente" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid x:Name="ClassicPatchWorkspacePanel"
                                  Margin="0,2,0,0"
                                  Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="245" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.RowSpan="3"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderLineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,14,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Filtre récepteur RX" FontWeight="SemiBold" />
                                <ListBox x:Name="ReceiverDeviceList"
                                         Grid.Row="1"
                                         SelectionChanged="ReceiverDeviceList_SelectionChanged"
                                         Margin="0,8,0,16" />

                                <TextBlock Grid.Row="2" Text="Filtre émetteur TX" FontWeight="SemiBold" />
                                <ListBox x:Name="SenderDeviceList"
                                         Grid.Row="3"
                                         SelectionChanged="SenderDeviceList_SelectionChanged"
                                         Margin="0,8,0,0" />
                                <Button x:Name="OpenVisualPatchButton"
                                        Grid.Row="4"
                                        Content="Easy patch"
                                        Visibility="Collapsed"
                                        Margin="0,12,0,0"
                                        Click="OpenVisualPatchButton_Click"
                                        ToolTip="Ouvre l'onglet Easy patch." />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderLineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Label Content="Recherche device ou canal" />
                                <Label Grid.Column="1" Content="Filtre état" />
                                <Label Grid.Column="2" Content="Source TX à appliquer" />
                                <Label Grid.Column="3" Content="Canal TX à appliquer" />
                                <Label Grid.Column="4" Content="Affichage" />

                                <TextBox x:Name="PatchSearchTextBox"
                                         Grid.Row="1"
                                         TextChanged="PatchFilter_Changed"
                                         Margin="0,0,8,0" />
                                <ComboBox x:Name="PatchStateFilterComboBox"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          SelectionChanged="PatchFilter_SelectionChanged"
                                          Margin="0,0,8,0" />
                                <ComboBox x:Name="SourceDeviceComboBox"
                                          Grid.Row="1"
                                          Grid.Column="2"
                                          SelectionChanged="SourceDeviceComboBox_SelectionChanged"
                                          Margin="0,0,8,0" />
                                <ComboBox x:Name="SourceChannelComboBox"
                                          Grid.Row="1"
                                          Grid.Column="3"
                                          SelectionChanged="SourceChannelComboBox_SelectionChanged"
                                          Margin="0,0,8,0" />
                                <ComboBox x:Name="PatchViewModeComboBox"
                                          Grid.Row="1"
                                          Grid.Column="4"
                                          Width="125"
                                          SelectionChanged="PatchViewModeComboBox_SelectionChanged"
                                          Margin="0,0,8,0" />
                                <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal">
                                    <Button x:Name="ApplyPatchButton" Content="Appliquer" Click="ApplyPatchButton_Click" />
                                    <Button x:Name="RemovePatchButton" Content="Supprimer" Style="{StaticResource SecondaryButtonStyle}" Click="RemovePatchButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="PatchGrid"
                                  Grid.Column="1"
                                  Grid.Row="1"
                                  IsReadOnly="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  CellEditEnding="PatchGrid_CellEditEnding"
                                  PreparingCellForEdit="PatchGrid_PreparingCellForEdit"
                                  SelectionChanged="PatchGrid_SelectionChanged">
                            <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RowState}" Value="Conflict">
                                            <Setter Property="Background" Value="#7F1D1D" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RowState}" Value="Modified">
                                            <Setter Property="Background" Value="#3B2F12" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RowState}" Value="Warning">
                                            <Setter Property="Background" Value="#78350F" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RowState}" Value="Local">
                                            <Setter Property="Background" Value="#064E3B" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="PatchRxDeviceColumn" Header="RX device" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RxDevice}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding RxDevice, Mode=OneWay}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="PatchRxDanteIdColumn" Header="RX Dante Id" Binding="{Binding RxDanteId}" Width="0.7*" IsReadOnly="True" />
                                <DataGridTemplateColumn x:Name="PatchRxChannelColumn" Header="RX canal" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RxChannelName}" VerticalAlignment="Center" />
                                                <Thumb Grid.Column="1"
                                                       Uid="Rx"
                                                       Tag="{Binding}"
                                                       Visibility="{Binding RxChannelName, Converter={StaticResource ChannelSeriesHandleVisibilityConverter}}"
                                                       Width="16"
                                                       Height="20"
                                                       Margin="5,0,0,0"
                                                       Cursor="SizeNS"
                                                       ToolTip="Étendre la série RX jusqu'à la ligne déposée"
                                                       DragStarted="PatchSeriesThumb_DragStarted"
                                                       DragCompleted="PatchSeriesThumb_DragCompleted">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="#DCE6F2" BorderBrush="#7890AC" BorderThickness="1" CornerRadius="2">
                                                                <TextBlock Text="↕" Foreground="#1F2937" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding RxChannelName, Mode=OneWay}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="PatchSourceFullColumn" Header="Source complète" Binding="{Binding SourceFull}" Width="1.7*" IsReadOnly="True" />
                                <DataGridTemplateColumn x:Name="PatchDisplayTxColumn" Header="TX device" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DisplayTxDeviceName}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding DisplayTxDeviceName, Mode=OneWay}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="PatchTxDanteIdColumn" Header="TX Dante Id" Binding="{Binding TxDanteIdDisplay}" Width="0.7*" IsReadOnly="True" />
                                <DataGridTextColumn x:Name="PatchRawTxColumn" Header="TX brut XML" Binding="{Binding RawTxDeviceName}" Width="0.9*" IsReadOnly="True" />
                                <DataGridTextColumn x:Name="PatchResolvedTxColumn" Header="TX résolu" Binding="{Binding ResolvedTxDeviceName}" Width="1.1*" IsReadOnly="True" />
                                <DataGridTemplateColumn x:Name="PatchTxChannelColumn" Header="TX canal" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TxChannelName}" VerticalAlignment="Center" />
                                                <Thumb Grid.Column="1"
                                                       Uid="Tx"
                                                       Tag="{Binding}"
                                                       Visibility="{Binding TxChannelName, Converter={StaticResource ChannelSeriesHandleVisibilityConverter}}"
                                                       Width="16"
                                                       Height="20"
                                                       Margin="5,0,0,0"
                                                       Cursor="SizeNS"
                                                       ToolTip="Étendre la série TX jusqu'à la ligne déposée"
                                                       DragStarted="PatchSeriesThumb_DragStarted"
                                                       DragCompleted="PatchSeriesThumb_DragCompleted">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="#DCE6F2" BorderBrush="#7890AC" BorderThickness="1" CornerRadius="2">
                                                                <TextBlock Text="↕" Foreground="#1F2937" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding TxChannelName, Mode=OneWay}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="PatchTypeColumn" Header="Type" Binding="{Binding TypeLabel}" Width="1*" IsReadOnly="True" />
                                <DataGridCheckBoxColumn x:Name="PatchActiveColumn" Header="Actif" Binding="{Binding IsActive, Mode=OneWay}" Width="0.7*" IsReadOnly="True" />
                                <DataGridCheckBoxColumn x:Name="PatchModifiedColumn" Header="Modifié" Binding="{Binding IsModified, Mode=OneWay}" Width="0.8*" IsReadOnly="True" />
                                <DataGridTextColumn x:Name="PatchStatusColumn" Header="État" Binding="{Binding Status}" Width="1.5*" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Column="1" Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ConflictsOnlyCheckBox"
                                      Content="Afficher seulement les conflits"
                                      Checked="PatchFilter_Changed"
                                      Unchecked="PatchFilter_Changed"
                                      Margin="0,0,18,0"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Name="PatchSummaryTextBlock"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Grid>
                            </Grid>

                            <ContentControl x:Name="EasyPatchHost">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderLineBrush}"
                                        BorderThickness="1"
                                        Padding="20">
                                    <TextBlock Text="Chargez un XML pour utiliser Easy patch."
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </Border>
                            </ContentControl>

                            <Grid x:Name="PendingPatchWorkspacePanel"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Modifications Patch en attente"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="PendingPatchHelpTextBlock"
                                                   Text="Les clics directs sont appliqués immédiatement. Cette liste contient seulement les lots explicitement préparés."
                                                   Margin="0,5,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock x:Name="PatchRebaseWarningsTextBlock"
                                                   Margin="0,6,0,0"
                                                   Foreground="#F59E0B"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <DataGrid x:Name="PendingPatchGrid"
                                          Grid.Row="1"
                                          IsReadOnly="True"
                                          AutoGenerateColumns="False"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          AutomationProperties.Name="Liste des modifications Patch en attente">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="RX device"
                                                            Binding="{Binding RxDeviceName}"
                                                            Width="1.3*" />
                                        <DataGridTextColumn Header="RX Dante Id"
                                                            Binding="{Binding RxDanteId}"
                                                            Width="0.7*" />
                                        <DataGridTextColumn Header="Source actuelle"
                                                            Binding="{Binding OriginalSource}"
                                                            Width="1.6*" />
                                        <DataGridTextColumn Header="Source demandée"
                                                            Binding="{Binding DesiredSource}"
                                                            Width="1.6*" />
                                        <DataGridTextColumn Header="Action"
                                                            Binding="{Binding ActionLabel}"
                                                            Width="0.9*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PendingPatchSummaryTextBlock"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <Button x:Name="DiscardPendingPatchButton"
                                                Content="Annuler le lot"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="DiscardPendingPatchButton_Click"
                                                ToolTip="Supprime uniquement les modifications Patch encore en attente." />
                                        <Button x:Name="ApplyPendingPatchButton"
                                                Content="Appliquer le lot"
                                                Click="ApplyPendingPatchButton_Click"
                                                ToolTip="Applique toutes les modifications en attente en une transaction annulable." />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ExportsTab" Header="Import / Export">
                    <TabControl x:Name="ExportsInnerTabs"
                                Margin="0,8,0,0"
                                SelectionChanged="ExportsInnerTabs_SelectionChanged">
                        <TabItem x:Name="ChannelLabelsTab" Header="Labels">
                            <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderLineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Text="Import et export de labels"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Labels JSON/CSV, DMT XLSX/ODS, A&amp;H dLive/Avantis et Yamaha CL/QL."
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1"
                              MaxWidth="1100"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Header="Importer des labels" Margin="0,0,10,0" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Importez des labels JSON/CSV, DMT XLSX/ODS, A&amp;H CSV ou Yamaha CL/QL ZIP/CSV."
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,0,0,18" />
                                    <Button x:Name="ImportChannelLabelsButton"
                                            Content="Importer des labels"
                                            HorizontalAlignment="Stretch"
                                            Click="ImportChannelLabelsButton_Click"
                                            ToolTip="Détecte les formats génériques, DMT, A&amp;H et Yamaha, puis prévisualise les labels avant de les appliquer aux machines Dante." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Column="1" Header="Exporter des labels" Margin="10,0,0,0" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Exportez en générique ou créez une copie d'un modèle DMT, A&amp;H ou Yamaha."
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,0,0,18" />
                                    <Button x:Name="ExportChannelLabelsButton"
                                            Content="Exporter des labels"
                                            HorizontalAlignment="Stretch"
                                            Click="ExportChannelLabelsButton_Click"
                                            ToolTip="Exporte les labels TX/RX et ne modifie jamais les modèles DMT, A&amp;H ou Yamaha originaux." />
                                </StackPanel>
                            </GroupBox>
                        </Grid>

                        <Button x:Name="OpenDmtProjectButton"
                                Grid.Row="2"
                                Content="Compatibilité DMT dLive / Avantis - ouvrir le projet"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,6"
                                Click="OpenDmtProjectButton_Click"
                                ToolTip="Ouvre la page GitHub de dLive MIDI Tools par togrupe, dont les modèles dLive et Avantis sont compatibles." />
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="ReportsExportTab" Header="Rapports et patchbook">
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <GroupBox Header="Rapports du projet" Padding="18" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Exportez un résumé lisible de la configuration chargée."
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,16" />
                                        <Button Content="Exporter TXT"
                                                Click="ExportTxtButton_Click"
                                                HorizontalAlignment="Stretch" />
                                        <Button Content="Exporter PDF"
                                                Click="ExportPdfButton_Click"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Grid.Column="1" Header="Patchbook" Padding="18" Margin="8,0">
                                    <StackPanel>
                                        <TextBlock Text="Choisissez le périmètre, puis exportez les affectations de patch."
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,16" />
                                        <ComboBox x:Name="PatchbookScopeComboBox"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="0,0,0,8" />
                                        <Button Content="Patchbook TXT"
                                                Click="ExportPatchbookTxtButton_Click"
                                                HorizontalAlignment="Stretch" />
                                        <Button Content="Patchbook CSV"
                                                Click="ExportPatchbookCsvButton_Click"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Grid.Column="2" Header="Analyse simple" Padding="18" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Créez une vue textuelle compacte des liaisons entre machines."
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,16" />
                                        <Button Content="Topologie simple"
                                                Click="TopologyButton_Click"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="SynopticTab" Header="Synoptique">
                            <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderLineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Synoptique visuel"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Machines regroupées par emplacement et patchs consécutifs réunis sur un même câble."
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="SynopticSummaryTextBlock"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="Aucun fichier chargé." />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="410" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Emplacement de la sélection" FontWeight="SemiBold" />
                                        <Grid Grid.Row="1" Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="SynopticLocationComboBox"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      StaysOpenOnEdit="True"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Saisissez une nouvelle zone ou choisissez une zone déjà utilisée." />
                                            <Button x:Name="ApplySynopticLocationButton"
                                                    Grid.Column="1"
                                                    Content="Affecter"
                                                    Margin="8,0,0,0"
                                                    Click="ApplySynopticLocationButton_Click"
                                                    ToolTip="Affecte cet emplacement aux machines sélectionnées." />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <DataGrid x:Name="SynopticDeviceGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          SelectionMode="Extended"
                                          SelectionUnit="FullRow"
                                          SelectionChanged="SynopticDeviceGrid_SelectionChanged"
                                          CellEditEnding="SynopticDeviceGrid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Voir" Width="52">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Click="SynopticVisibilityCheckBox_Click" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Machine" Binding="{Binding DeviceName}" IsReadOnly="True" Width="1.35*" />
                                        <DataGridTextColumn Header="Emplacement" Binding="{Binding Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.25*" />
                                        <DataGridTextColumn Header="Ordre" Binding="{Binding Order, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <DataGridTextColumn Header="TX/RX" Binding="{Binding ChannelCount}" IsReadOnly="True" Width="72" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <Border Grid.Column="2"
                                    Background="#F7F9FC"
                                    BorderBrush="{DynamicResource BorderLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderLineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,6">
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Content="−" Width="34" Click="ZoomOutSynopticButton_Click" ToolTip="Zoom arrière" />
                                            <Slider x:Name="SynopticZoomSlider"
                                                    Width="150"
                                                    Minimum="0.1"
                                                    Maximum="2.5"
                                                    Value="1"
                                                    TickFrequency="0.25"
                                                    Margin="7,0"
                                                    ValueChanged="SynopticZoomSlider_ValueChanged" />
                                            <Button Content="+" Width="34" Click="ZoomInSynopticButton_Click" ToolTip="Zoom avant" />
                                            <TextBlock x:Name="SynopticZoomTextBlock" Text="100 %" Width="58" TextAlignment="Center" VerticalAlignment="Center" />
                                            <Button Content="100 %" Margin="5,0,0,0" Click="ResetSynopticZoomButton_Click" ToolTip="Revenir à la taille réelle" />
                                            <Button Content="Ajuster" Margin="5,0,0,0" Click="FitSynopticZoomButton_Click" ToolTip="Afficher tout le synoptique" />
                                            <Button x:Name="CenterSynopticSelectionButton"
                                                    Content="Centrer"
                                                    Margin="5,0,0,0"
                                                    Click="CenterSynopticSelectionButton_Click"
                                                    ToolTip="Centre la machine ou la liaison sélectionnée." />
                                            <TextBlock Text="Emplacement"
                                                       VerticalAlignment="Center"
                                                       Margin="14,0,6,0" />
                                            <ComboBox x:Name="SynopticLocationFilterComboBox"
                                                      Width="155"
                                                      SelectionChanged="SynopticLocationFilterComboBox_SelectionChanged"
                                                      ToolTip="Filtre l’aperçu sans masquer durablement les machines et sans modifier le XML." />
                                            <Button x:Name="OpenSynopticPreviewWindowButton"
                                                    Content="↗"
                                                    Width="36"
                                                    Margin="5,0,0,0"
                                                    ToolTip="Ouvrir l’aperçu dans une fenêtre séparée"
                                                    AutomationProperties.Name="Ouvrir l’aperçu du synoptique dans une fenêtre séparée"
                                                    Click="OpenSynopticPreviewWindowButton_Click" />
                                        </WrapPanel>
                                    </Border>
                                    <ScrollViewer x:Name="SynopticScrollViewer"
                                                  Grid.Row="1"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  PreviewMouseWheel="SynopticScrollViewer_PreviewMouseWheel"
                                                  PreviewMouseDown="SynopticScrollViewer_PreviewMouseDown"
                                                  PreviewMouseMove="SynopticScrollViewer_PreviewMouseMove"
                                                  PreviewMouseUp="SynopticScrollViewer_PreviewMouseUp">
                                        <Canvas x:Name="SynopticCanvas"
                                                Width="900"
                                                Height="560"
                                                Background="#F7F9FC" />
                                    </ScrollViewer>
                                    <Border x:Name="SynopticSelectionPanel"
                                            Grid.Row="2"
                                            Visibility="Collapsed"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderLineBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="12,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="SynopticSelectionTitleTextBlock"
                                                           FontWeight="SemiBold"
                                                           Text="Sélection du synoptique" />
                                                <TextBlock x:Name="SynopticSelectionSubtitleTextBlock"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock x:Name="SynopticSelectionDetailsTextBlock"
                                                           Margin="0,5,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="78" />
                                            </StackPanel>
                                            <Button x:Name="SynopticSelectionActionButton"
                                                    Grid.Column="1"
                                                    Content="Ouvrir dans Patch"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Click="SynopticSelectionActionButton_Click"
                                                    ToolTip="Ouvre la machine ou la première subscription de cette liaison dans la vue correspondante." />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ShowAllSynopticDevicesButton"
                                        Content="Tout afficher"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ShowAllSynopticDevicesButton_Click" />
                                <Button x:Name="HideSelectedSynopticDevicesButton"
                                        Content="Masquer sélection"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="HideSelectedSynopticDevicesButton_Click" />
                                <Button x:Name="MoveSynopticDeviceUpButton"
