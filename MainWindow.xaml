                                             Grid.Row="2"
                                             MinHeight="120"
                                             MaxHeight="260"
                                             MouseDoubleClick="HomeRecentFilesListBox_MouseDoubleClick"
                                             AutomationProperties.Name="Fichiers récents" />
                                    <Button Grid.Row="3"
                                            Content="Ouvrir le fichier sélectionné"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            Click="HomeOpenRecentButton_Click" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ShellPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Récupération et sécurité"
                                               Style="{StaticResource ShellSectionTitleStyle}" />
                                    <TextBlock x:Name="RecoveryAvailabilityTextBlock"
                                               Text="Aucune récupération en attente détectée."
                                               Style="{StaticResource ShellCaptionStyle}" />
                                    <TextBlock Text="DCE travaille hors ligne sur des fichiers. Une sauvegarde de sécurité est conservée lors des remplacements atomiques."
                                               Style="{StaticResource ShellCaptionStyle}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="OverviewTab" Header="Vue d'ensemble">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16">
                            <TextBlock Text="Vue d'ensemble"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="OverviewStatusTextBlock"
                                       Text="Chargez un XML pour analyser rapidement sa configuration."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,0,16" />

                            <WrapPanel>
                                <Button Style="{StaticResource ShellMetricButtonStyle}"
                                        Tag="Machines"
                                        Click="OverviewMetricButton_Click"
                                        ToolTip="Ouvre la liste des machines.">
                                    <StackPanel>
                                        <TextBlock x:Name="OverviewDevicesValueTextBlock"
                                                   Text="0"
                                                   FontSize="22"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Machines"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ShellMetricButtonStyle}"
                                        Tag="Patch"
                                        Click="OverviewMetricButton_Click"
                                        ToolTip="Ouvre l'espace Patch.">
                                    <StackPanel>
                                        <TextBlock x:Name="OverviewPatchValueTextBlock"
                                                   Text="0"
                                                   FontSize="22"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Subscriptions"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ShellMetricButtonStyle}"
                                        Tag="Validation"
                                        Click="OverviewMetricButton_Click"
                                        ToolTip="Ouvre les erreurs et avertissements.">
                                    <StackPanel>
                                        <TextBlock x:Name="OverviewValidationValueTextBlock"
                                                   Text="0 / 0"
                                                   FontSize="22"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Erreurs / avertissements"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ShellMetricButtonStyle}"
                                        Tag="Machines"
                                        Click="OverviewMetricButton_Click"
                                        ToolTip="Ouvre la liste des machines et ses filtres.">
                                    <StackPanel>
                                        <TextBlock x:Name="OverviewUnpatchedValueTextBlock"
                                                   Text="0"
                                                   FontSize="22"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Machines sans patch"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <Border Style="{StaticResource ShellPanelStyle}"
                                    Margin="{StaticResource ShellSectionSpacing}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="Audio"
                                                   Style="{StaticResource ShellSectionTitleStyle}" />
                                        <TextBlock x:Name="OverviewAudioTextBlock"
                                                   Text=""
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Réseau et horloge"
                                                   Style="{StaticResource ShellSectionTitleStyle}" />
                                        <TextBlock x:Name="OverviewNetworkTextBlock"
                                                   Text=""
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ShellPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Dernières modifications"
                                               Style="{StaticResource ShellSectionTitleStyle}" />
                                    <ListBox x:Name="OverviewChangesListBox"
                                             Grid.Row="1"
                                             MinHeight="100"
                                             MaxHeight="220"
                                             Style="{StaticResource PanelListBoxStyle}"
                                             ItemContainerStyle="{StaticResource PanelListBoxItemStyle}"
                                             IsHitTestVisible="False"
                                             AutomationProperties.Name="Dernières modifications du projet" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="DeviceLibraryShellTab"
                         Header="Banque de machines"
                         Visibility="Collapsed">
                    <Grid Margin="16">
                        <StackPanel MaxWidth="720"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                            <TextBlock Text="Banque de machines"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="La banque stocke des modèles réutilisables dans un dossier lisible et partageable. L'ouverture reste séparée pendant sa migration vers le shell 2026.1."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,0,16" />
                            <Button Content="Ouvrir la banque de machines"
                                    HorizontalAlignment="Left"
                                    Click="OpenMachineBankButton_Click"
                                    ToolTip="Ouvre l'administration, l'import, l'export et la migration de la banque." />
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter x:Name="InspectorSplitter"
                          Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderLineBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <Button x:Name="InspectorRevealButton"
                    Grid.Column="3"
                    Content="&gt;"
                    Visibility="Visible"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Panel.ZIndex="2"
                    Style="{StaticResource PanelRevealButtonStyle}"
                    Click="InspectorToggleButton_Click"
                    ToolTip="Masquer inspecteur"
                    AutomationProperties.Name="Masquer inspecteur"
                    AutomationProperties.HelpText="Masque ou rouvre l'inspecteur contextuel." />

            <Border Grid.Column="4"
                    x:Name="InspectorBorder"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="InspectorTitleTextBlock"
                                       Text="Inspecteur"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="InspectorSubtitleTextBlock"
                                       Text="Projet"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="InspectorEmptyTextBlock"
                                       Text="Chargez un projet ou sélectionnez une machine pour afficher ses propriétés."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,0,12" />

                            <StackPanel x:Name="InspectorProjectPanel">
                                <TextBlock Text="Projet"
                                           Style="{StaticResource ShellSectionTitleStyle}" />
                                <TextBlock x:Name="InspectorProjectSummaryTextBlock"
                                           Text="Aucun projet chargé"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,0,0,14" />
                            </StackPanel>

                            <StackPanel x:Name="InspectorDevicePanel"
                                        Visibility="Collapsed">
                                <TextBlock Text="Machine sélectionnée"
                                           Style="{StaticResource ShellSectionTitleStyle}" />
                                <TextBlock x:Name="InspectorSelectionCountTextBlock"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Nom" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,10,6" />
                                    <TextBlock x:Name="InspectorDeviceNameTextBlock" Grid.Column="1" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="1" Text="Constructeur" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,10,6" />
                                    <TextBlock x:Name="InspectorManufacturerTextBlock" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="2" Text="Modèle" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,10,6" />
                                    <TextBlock x:Name="InspectorModelTextBlock" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="3" Text="TX / RX" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,10,6" />
                                    <TextBlock x:Name="InspectorChannelCountsTextBlock" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="4" Text="IP" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,10,6" />
                                    <TextBlock x:Name="InspectorIpTextBlock" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="5" Text="Audio" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,10,6" />
                                    <TextBlock x:Name="InspectorAudioTextBlock" Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="6" Text="Latence" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,10,6" />
                                    <TextBlock x:Name="InspectorLatencyTextBlock" Grid.Row="6" Grid.Column="1" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="7" Text="Réseau" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,10,6" />
                                    <TextBlock x:Name="InspectorNetworkModeTextBlock" Grid.Row="7" Grid.Column="1" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="8" Text="Horloge" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,10,6" />
                                    <TextBlock x:Name="InspectorClockTextBlock" Grid.Row="8" Grid.Column="1" Margin="0,0,0,6" />
                                </Grid>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Détails"
                                            Click="InspectorOpenDeviceButton_Click"
                                            ToolTip="Ouvre toutes les propriétés de la machine sélectionnée." />
                                    <Button Content="Voir dans Patch"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="InspectorOpenPatchButton_Click"
                                            ToolTip="Filtre le Patch autour de la machine sélectionnée." />
                                </WrapPanel>

                                <Expander Header="Identité technique"
                                          Margin="0,10,0,0"
                                          ToolTip="Informations avancées conservées par le XML.">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="InspectorTechnicalIdTextBlock"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <TextBlock x:Name="InspectorWarningsTextBlock"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Margin="0,14,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Une grille dédiée garantit que le crédit reste visible à droite.
             Le StatusBar natif compressait son dernier élément sur deux lignes. -->
        <Border Grid.Row="3"
                MinHeight="34"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderLineBrush}"
                BorderThickness="0,1,0,0"
                Padding="4,2,8,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock"
                               Text="Prêt"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <Border Width="1" Height="16" Margin="7,0"
                            Background="{DynamicResource BorderLineBrush}" />
                    <TextBlock x:Name="ModeTextBlock"
                               Text="Mode : Lecture seule"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <Border Width="1" Height="16" Margin="7,0"
                            Background="{DynamicResource BorderLineBrush}" />
                    <TextBlock x:Name="CountsTextBlock"
                               Text="0 device - 0 TX - 0 RX"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="By Mamat"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextAlignment="Right"
                               Opacity="0.82" />
                    <TextBlock Text="et ses agents"
                               FontSize="8"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextAlignment="Right"
                               Opacity="0.68" />
                    <TextBlock Text="-------[]--"
                               FontSize="7"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextAlignment="Right"
                               Opacity="0.52" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
