                                        Click="ExportSynopticButton_Click"
                                        ToolTip="Crée un fichier vectoriel en couleur sans modifier le XML Dante." />
                                <Button x:Name="ExportSynopticPdfButton"
                                        Content="Exporter le synoptique PDF"
                                        Click="ExportSynopticPdfButton_Click"
                                        ToolTip="Crée un PDF vectoriel en couleur sans modifier le XML Dante." />
                            </StackPanel>
                        </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem x:Name="HealthTab" Header="Santé du fichier">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderLineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Centre de validation"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="HealthSummaryTextBlock"
                                               Text="Aucun fichier chargé."
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="HealthProfileTextBlock"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Grid.Column="1" Margin="16,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <Label Content="Filtre de validation" />
                                        <ComboBox x:Name="HealthFilterComboBox"
                                                  SelectionChanged="HealthFilter_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                        <Label Content="Rechercher dans les résultats" />
                                        <TextBox x:Name="HealthSearchTextBox"
                                                 TextChanged="HealthSearchTextBox_TextChanged"
                                                 ToolTip="Filtre les messages, catégories, machines et chemins XML." />
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Margin="0,12,0,0">
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource DangerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,5"
                                            Margin="0,0,8,0">
                                        <TextBlock x:Name="ValidationErrorCountTextBlock"
                                                   Text="0 erreur bloquante"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource WarningBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,5"
                                            Margin="0,0,8,0">
                                        <TextBlock x:Name="ValidationWarningCountTextBlock"
                                                   Text="0 avertissement"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,5">
                                        <TextBlock x:Name="ValidationInformationCountTextBlock"
                                                   Text="0 information"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </WrapPanel>

                                <TextBlock x:Name="ValidationScopeTextBlock"
                                           Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Margin="0,10,0,0"
                                           Text="Validation interne DCE : structure XML et cohérence hors ligne. Le comportement matériel et réseau reste à contrôler dans Dante Controller."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <DataGrid x:Name="HealthIssuesGrid"
                                  Grid.Row="1"
                                  Margin="0,0,0,12"
                                  SelectionChanged="HealthIssuesGrid_SelectionChanged"
                                  MouseDoubleClick="HealthIssuesGrid_MouseDoubleClick"
                                  ToolTip="Sélectionnez un résultat pour afficher ses détails. Double-cliquez pour ouvrir l’élément concerné.">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Niveau" Binding="{Binding SeverityLabel}" Width="0.9*" />
                                <DataGridTextColumn Header="Catégorie" Binding="{Binding CategoryLabel}" Width="1.1*" />
                                <DataGridTextColumn Header="Élément concerné" Binding="{Binding TargetLabel}" Width="1.6*" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="3.4*" />
                                <DataGridTextColumn Header="Chemin XML" Binding="{Binding XmlPath}" Width="1.8*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderLineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="ValidationDetailTitleTextBlock"
                                               Text="Détail du résultat"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="ValidationDetailTextBlock"
                                               Text="Sélectionnez un résultat pour afficher son détail technique."
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,5,16,0"
                                               MaxHeight="86"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="ValidationSuggestedActionTextBlock"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,5,16,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1"
                                           VerticalAlignment="Bottom">
                                    <Button x:Name="OpenValidationTargetButton"
                                            Content="Ouvrir l’élément"
                                            Click="OpenValidationTargetButton_Click"
                                            IsEnabled="False"
                                            ToolTip="Ouvre la machine, le canal ou le patch associé au résultat." />
                                    <Button x:Name="ExportValidationReportButton"
                                            Content="Exporter le rapport"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ExportValidationReportButton_Click"
                                            ToolTip="Exporte le résultat complet de la validation interne DCE." />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="SafetyTab" Header="Sécurité et journal">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel>
                            <Button Content="Vérifier le fichier" Click="ValidateButton_Click" />
                            <Button Content="Rapport final avant Dante"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="FinalDanteCheckButton_Click"
                                    ToolTip="Affiche un résumé OK / points à vérifier avant d'importer le XML dans Dante Controller." />
                            <Button Content="Rapport compatibilité Dante Controller" Style="{StaticResource SecondaryButtonStyle}" Click="CompatibilityReportButton_Click" />
                            <Button Content="Actualiser le résumé" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshSummaryButton_Click" />
                            <Button Content="Historique actions"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ActionHistoryButton_Click"
                                    ToolTip="Affiche les dernières actions réalisées dans l'application." />
                            <Button Content="Comparer XML" Style="{StaticResource SecondaryButtonStyle}" Click="CompareXmlButton_Click" />
                            <Button Content="Quick start"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenQuickStartButton_Click"
                                    ToolTip="Ouvre la notice rapide PDF." />
                             <Button Content="Notice complète"
                                     Style="{StaticResource SecondaryButtonStyle}"
                                     Click="OpenFullNoticeButton_Click"
                                     ToolTip="Ouvre la notice complète PDF." />
                             <Button x:Name="SupportDceButton"
                                     Content="Soutenir DCE"
                                     Style="{StaticResource SecondaryButtonStyle}"
                                     Click="SupportDceButton_Click"
                                     ToolTip="Présente les moyens facultatifs de soutenir ce projet gratuit." />
                             <Button Content="Ouvrir les journaux"
                                     Style="{StaticResource SecondaryButtonStyle}"
                                     Click="OpenDiagnosticLogsButton_Click"
                                     ToolTip="Ouvre le dossier des journaux techniques utiles au diagnostic." />
                         </WrapPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SaveSummaryTextBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,14,0" />

                            <Border Grid.Column="1"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Journal" FontWeight="SemiBold" FontSize="16" />
                                    <ListBox x:Name="LogListBox" Grid.Row="1" Margin="0,12,0,0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="AtomicBombTab" Header="Atomic Bomb">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <Grid MinWidth="980"
                              MaxWidth="1120"
                              HorizontalAlignment="Left"
                              Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="20,16"
                                    Background="#2B1114"
                                    BorderBrush="#8B1A1A"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ATOMIC BOMB"
                                                   Foreground="White"
                                                   FontSize="24"
                                                   FontWeight="Bold" />
                                        <TextBlock Margin="0,4,20,0"
                                                   MaxWidth="760"
                                                   Foreground="#FECACA"
                                                   TextWrapping="Wrap"
                                                   Text="Générateur d'expérience horrible, mais pédagogique. Le projet chargé devient une copie d'exercice volontairement chaotique." />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="14,8"
                                            VerticalAlignment="Center"
                                            Background="#111827"
                                            BorderBrush="#64748B"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock x:Name="AtomicPanelStatusTextBlock"
                                                   Text="SAFE · Tournez la clé"
                                                   Foreground="#94A3B8"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1"
                                  Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="440" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="AtomicOptionsBorder"
                                        Grid.Column="0"
                                        Padding="18"
                                        Background="#24181D"
                                        BorderBrush="#5F3036"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="PÉRIMÈTRE DE L'EXERCICE"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   FontWeight="Bold" />
                                        <TextBlock Margin="0,4,0,12"
                                                   Foreground="#FECACA"
                                                   TextWrapping="Wrap"
                                                   Text="Décochez les catégories qui doivent rester intactes." />
                                        <UniformGrid Columns="2">
                                            <CheckBox x:Name="AtomicDeviceNamesCheckBox" Content="Noms des machines" IsChecked="True" Foreground="White" Margin="4,5" />
                                            <CheckBox x:Name="AtomicTxLabelsCheckBox" Content="Labels des canaux TX" IsChecked="True" Foreground="White" Margin="4,5" />
                                            <CheckBox x:Name="AtomicRxLabelsCheckBox" Content="Labels des canaux RX" IsChecked="True" Foreground="White" Margin="4,5" />
                                            <CheckBox x:Name="AtomicPatchesCheckBox" Content="Patchs / subscriptions" IsChecked="True" Foreground="White" Margin="4,5" />
                                            <CheckBox x:Name="AtomicNetworkModeCheckBox" Content="Modes réseau" IsChecked="True" Foreground="White" Margin="4,5" />
                                            <CheckBox x:Name="AtomicPreferredMasterCheckBox" Content="Preferred Master" IsChecked="True" Foreground="White" Margin="4,5" />
                                            <CheckBox x:Name="AtomicLatencyCheckBox" Content="Latences" IsChecked="True" Foreground="White" Margin="4,5" />
                                            <CheckBox x:Name="AtomicSampleRateCheckBox" Content="Fréquences d'échantillonnage" IsChecked="True" Foreground="White" Margin="4,5" />
                                            <CheckBox x:Name="AtomicEncodingCheckBox" Content="Bits par échantillon" IsChecked="True" Foreground="White" Margin="4,5" />
                                            <CheckBox x:Name="AtomicIpCheckBox" Content="IP principales" IsChecked="True" Foreground="White" Margin="4,5" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Padding="18"
                                        Background="#111827"
                                        BorderBrush="#64748B"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="PUPITRE DE COMMANDE"
                                                   Foreground="#CBD5E1"
                                                   FontSize="16"
                                                   FontWeight="Bold" />

                                        <Grid Grid.Row="1"
                                              Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="AUTORISATION"
                                                           Foreground="#94A3B8"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"
                                                           Margin="0,0,0,8" />
                                                <Button x:Name="AtomicKeyButton"
                                                        ContentTemplate="{x:Null}"
                                                        Style="{StaticResource AtomicSequenceButtonStyle}"
                                                        Click="AtomicKeyButton_Click"
                                                        ToolTip="Tourne la clé et ouvre automatiquement le capot. Un second clic remet le pupitre en sécurité."
                                                        AutomationProperties.Name="Clé de sécurité Atomic Bomb">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="54" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid x:Name="AtomicKeyVisual"
                                                              Width="48"
                                                              Height="48"
                                                              VerticalAlignment="Center"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Grid.RenderTransform>
                                                                <RotateTransform x:Name="AtomicKeyRotateTransform"
                                                                                 Angle="0" />
                                                            </Grid.RenderTransform>
                                                            <Ellipse Width="46"
                                                                     Height="46"
                                                                     Fill="#111827"
                                                                     Stroke="#94A3B8"
                                                                     StrokeThickness="2" />
                                                            <Rectangle Width="8"
                                                                       Height="30"
                                                                       RadiusX="3"
                                                                       RadiusY="3"
                                                                       Fill="#E5E7EB"
                                                                       Stroke="#64748B"
                                                                       StrokeThickness="1" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock x:Name="AtomicKeyTitleTextBlock"
                                                                       Text="1. CLÉ"
                                                                       Foreground="White"
                                                                       FontWeight="Bold"
                                                                       TextAlignment="Left" />
                                                            <TextBlock x:Name="AtomicKeyPositionTextBlock"
                                                                       Text="OFF"
                                                                       Foreground="#CBD5E1"
                                                                       FontSize="11"
                                                                       TextAlignment="Left" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </StackPanel>

                                            <Grid Grid.Column="2">
                                                <Border Background="#1F2937"
                                                        BorderBrush="#475569"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="12">
                                                    <UniformGrid x:Name="AtomicButtonDeck"
                                                                 Columns="3">
                                                        <Button x:Name="AtomicArmButton"
                                                                Content="ARM"
                                                                MinWidth="108"
                                                                Style="{StaticResource AtomicSequenceButtonStyle}"
                                                                IsEnabled="False"
                                                                Click="AtomicArmButton_Click"
                                                                ToolTip="Arme la copie de travail sans encore la modifier." />
                                                        <Button x:Name="AtomicLockButton"
                                                                Content="LOCK"
                                                                MinWidth="108"
                                                                Style="{StaticResource AtomicSequenceButtonStyle}"
                                                                IsEnabled="False"
                                                                Click="AtomicLockButton_Click"
                                                                ToolTip="Verrouille les options choisies et autorise FIRE." />
                                                        <Button x:Name="AtomicChaosButton"
                                                                Content="FIRE"
                                                                Background="#4B1D22"
                                                                HorizontalAlignment="Center"
                                                                Style="{StaticResource AtomicButtonStyle}"
                                                                IsEnabled="False"
                                                                Click="AtomicChaosButton_Click"
                                                                ToolTip="Déclenche immédiatement l'exercice hors ligne lorsque ARM et LOCK sont actifs." />
                                                    </UniformGrid>
                                                </Border>

                                                <Border x:Name="AtomicSafetyCover"
                                                        Panel.ZIndex="2"
                                                        MinHeight="154"
                                                        Background="#D934171B"
                                                        BorderBrush="#EF4444"
                                                        BorderThickness="3"
                                                        CornerRadius="4"
                                                        ToolTip="La clé ouvre ce capot et révèle ARM, LOCK et FIRE.">
                                                    <StackPanel>
                                                        <TextBlock x:Name="AtomicCoverTitleTextBlock"
                                                                   Text="2. CAPOT DE SÉCURITÉ"
                                                                   Foreground="#FECACA"
                                                                   FontSize="17"
                                                                   FontWeight="Bold"
                                                                   TextAlignment="Center" />
                                                        <TextBlock x:Name="AtomicCoverHintTextBlock"
                                                                   Text="VERROUILLÉ · tourner la clé pour ouvrir"
                                                                   Foreground="#FECACA"
                                                                   TextAlignment="Center"
                                                                   Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2"
                                    Margin="0,12,0,0"
                                    Padding="14,10"
                                    Background="#3A171B"
                                    BorderBrush="#7F1D1D"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <TextBlock Foreground="#FCA5A5"
                                           MaxWidth="1040"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Text="Séquence : tournez la clé pour ouvrir le capot → ARM → LOCK → FIRE. FIRE agit immédiatement. Le XML original reste intact tant que vous n'écrasez pas volontairement son fichier." />
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="HomeTab" Header="Projet">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="1040"
                                    HorizontalAlignment="Left"
                                    Margin="16">
                            <TextBlock Text="Projet"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Ouvrez un XML Dante existant, reprenez un fichier récent ou créez un projet hors ligne."
