# Build outputs
bin/
obj/
publish/
artifacts/
TestResults/
*.trx
*.coverage
coverage.*
*.nupkg

# Distribution output is published through GitHub Releases, not committed.
dist/
*.dmg
*.app/
*.sha256

# Benchmark and manual-validation outputs are reproducible and machine-specific.
benchmarks/results/
validation-output/

# User and IDE files
.vs/
.vscode/
*.user
*.suo

# Logs and temporary files
*.log
*.tmp
*.bak
tmp/
__pycache__/
*.pyc

# Les captures brutes de la video restent locales : elles peuvent contenir
# des chemins de travail. Les videos finales et leurs sommes sont publiees.
docs/media/v3.3/
!docs/media/*.mp4.sha256
!docs/media/*.mkv.sha256
docs/media/v*/
docs/media/dce-v*-presentation-*

# Les longues notices video sont publiees comme assets de Release. Les SRT
# restent locaux dans Video Drafts ; seules les empreintes sont versionnees.
docs/media/dce-2026-1-guide-visuel-*.mp4
docs/media/dce-2026-1-guide-visual-*.mp4
docs/media/dce-2026-1-guide-visuel-*.mkv
docs/media/*.srt

# OS files
Thumbs.db
Desktop.ini
.DS_Store
