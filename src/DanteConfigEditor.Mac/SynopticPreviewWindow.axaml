<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DanteConfigEditor.Mac.SynopticPreviewWindow"
        Title="Aperçu du synoptique"
        Width="1280"
        Height="820"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*">
        <Border Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="Zoom" VerticalAlignment="Center" />
                    <Button x:Name="ZoomOutButton" Width="34" Padding="0" Click="ZoomOutButton_Click">−</Button>
                    <Slider x:Name="ZoomSlider"
                            Width="190"
                            Minimum="0.1"
                            Maximum="3"
                            Value="1"
                            ValueChanged="ZoomSlider_ValueChanged" />
                    <Button x:Name="ZoomInButton" Width="34" Padding="0" Click="ZoomInButton_Click">+</Button>
                    <TextBlock x:Name="ZoomText" Width="64" Text="100 %" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button x:Name="ActualSizeButton" Click="ActualSizeButton_Click">100 %</Button>
                    <Button x:Name="FitButton" Click="FitButton_Click">Ajuster</Button>
                </StackPanel>
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Click="CloseButton_Click">Fermer</Button>
            </Grid>
        </Border>

        <ScrollViewer x:Name="PreviewScrollViewer"
                      Grid.Row="1"
                      Background="#DCE3EC"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PointerWheelChanged="PreviewScrollViewer_PointerWheelChanged">
            <Border Background="#F7F9FC" Margin="20">
                <LayoutTransformControl x:Name="PreviewZoomHost">
                    <Rectangle x:Name="PreviewSurface"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top" />
                </LayoutTransformControl>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
