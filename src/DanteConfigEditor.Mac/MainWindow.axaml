<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1500"
        d:DesignHeight="930"
        x:Class="DanteConfigEditor.Mac.MainWindow"
        Title="Dante Config Editor 2026.1 Beta - macOS"
        Width="1500"
        Height="930"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <Menu x:Name="ApplicationMenu"
                      Grid.Row="0"
                      Background="Transparent">
                    <MenuItem Header="Fichier">
                        <MenuItem Header="Nouveau projet"
                                  Click="NewProjectButton_Click" />
                        <MenuItem Header="Ouvrir un XML"
                                  Click="OpenButton_Click" />
                        <MenuItem x:Name="MergeMenuItem"
                                  Header="Ajouter un XML au projet"
                                  Click="MergeButton_Click" />
                        <Separator />
                        <MenuItem x:Name="SaveMenuItem"
                                  Header="Enregistrer sous"
                                  Click="SaveButton_Click" />
                        <Separator />
                        <MenuItem Header="Quitter"
                                  Click="ExitMenuItem_Click" />
                    </MenuItem>

                    <MenuItem Header="Édition">
                        <MenuItem x:Name="UndoMenuItem"
                                  Header="Annuler"
                                  Click="UndoButton_Click" />
                        <MenuItem x:Name="RevertMenuItem"
                                  Header="Annuler les changements non enregistrés"
                                  Click="RevertButton_Click" />
                    </MenuItem>

                    <MenuItem Header="Machines">
                        <MenuItem Header="Ouvrir la banque de machines"
                                  Click="OpenMachineBankButton_Click" />
                        <MenuItem x:Name="AddDeviceFromBankMenuItem"
                                  Header="Ajouter depuis la banque"
                                  Click="AddDeviceFromBankButton_Click" />
                        <Separator />
                        <MenuItem x:Name="DuplicateDeviceMenuItem"
                                  Header="Dupliquer la machine sélectionnée"
                                  Click="DuplicateDeviceButton_Click" />
                        <MenuItem x:Name="SaveDeviceToBankMenuItem"
                                  Header="Enregistrer la machine dans la banque"
                                  Click="SaveDeviceToBankButton_Click" />
                        <MenuItem x:Name="DeleteDeviceMenuItem"
                                  Header="Supprimer la machine sélectionnée"
                                  Click="DeleteDeviceButton_Click" />
                    </MenuItem>

                    <MenuItem Header="Affichage">
                        <MenuItem Header="Machines"
                                  Tag="ConfigurationTab"
                                  Click="NavigateMenuItem_Click" />
                        <MenuItem Header="Patch"
                                  Tag="PatchTab"
                                  Click="NavigateMenuItem_Click" />
                        <MenuItem Header="Import / Export"
                                  Tag="ExportsTab"
                                  Click="NavigateMenuItem_Click" />
                        <MenuItem Header="Centre de validation"
                                  Tag="HealthTab"
                                  Click="NavigateMenuItem_Click" />
                        <MenuItem Header="Historique"
                                  Tag="SafetyTab"
                                  Click="NavigateMenuItem_Click" />
                        <Separator />
                        <MenuItem x:Name="ThemeMenuItem"
                                  Header="Thème clair"
                                  Click="ThemeMenuItem_Click" />
                    </MenuItem>

                    <MenuItem Header="Outils">
                        <MenuItem Header="Centre de validation"
                                  Tag="HealthTab"
                                  Click="NavigateMenuItem_Click" />
                        <MenuItem Header="Historique"
                                  Tag="SafetyTab"
                                  Click="NavigateMenuItem_Click" />
                        <MenuItem Header="Ouvrir les journaux"
                                  Click="OpenDiagnosticLogsButton_Click" />
                        <Separator />
                        <MenuItem Header="Atomic Bomb"
                                  Tag="AtomicTab"
                                  Click="NavigateMenuItem_Click" />
                    </MenuItem>

                    <MenuItem Header="Aide">
                        <MenuItem Header="Démarrage rapide"
                                  Click="QuickStartButton_Click" />
                        <MenuItem Header="Notice complète"
                                  Click="FullGuideButton_Click" />
                        <MenuItem Header="Notes de version"
                                  Click="OpenReleaseNotesMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="Projet GitHub"
                                  Click="OpenGitHubMenuItem_Click" />
                        <MenuItem Header="Soutenir DCE"
                                  Click="SupportDceButton_Click" />
                        <Separator />
                        <MenuItem Header="À propos de DCE"
                                  Click="AboutMenuItem_Click" />
                    </MenuItem>
                </Menu>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,120,Auto" ColumnSpacing="10">
                    <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Dante Config Editor 2026.1 Beta" FontSize="20" FontWeight="Bold" />
                    <TextBlock x:Name="FilePathText" Classes="muted" Text="Aucun fichier ouvert" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="DirtyStateText" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="Non modifié" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Langue" Classes="muted" />
                    <ComboBox x:Name="LanguageCombo" Grid.Column="3" SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Tag="fr">Français</ComboBoxItem>
                        <ComboBoxItem Tag="en">English</ComboBoxItem>
                    </ComboBox>
                    <Button x:Name="ThemeButton" Grid.Column="4" Click="ThemeButton_Click">Thème clair</Button>
                </Grid>

                <WrapPanel Grid.Row="2">
                    <Button x:Name="NewProjectButton"
                            Margin="0,0,8,8"
                            Click="NewProjectButton_Click"
                            ToolTip.Tip="Crée un nouveau projet hors ligne à partir d'une structure prise en charge.">Nouveau projet</Button>
                    <Button x:Name="OpenButton" Classes="primary" Margin="0,0,8,8" Click="OpenButton_Click" ToolTip.Tip="Charge un export XML Dante Controller.">Ouvrir XML</Button>
                    <Button x:Name="MergeButton" Margin="0,0,8,8" Click="MergeButton_Click" ToolTip.Tip="Ajoute les machines d'un autre XML au projet ouvert.">Ajouter XML</Button>
                    <Button x:Name="OpenMachineBankButton"
                            Margin="0,0,8,8"
                            Click="OpenMachineBankButton_Click"
                            ToolTip.Tip="Consulte, importe, exporte et administre les modèles de machines réutilisables.">Banque de machines</Button>
                    <Button x:Name="SaveButton" Classes="primary" Margin="0,0,8,8" Click="SaveButton_Click">Enregistrer sous</Button>
                    <Button x:Name="EditButton" Margin="0,0,8,8" Click="EditButton_Click">Activer l'édition</Button>
                    <Button x:Name="UndoButton" Margin="0,0,8,8" Click="UndoButton_Click">Annuler action</Button>
                    <Button x:Name="RevertButton" Margin="0,0,8,8" Click="RevertButton_Click">Annuler les changements</Button>
                    <ComboBox x:Name="RecentCombo" Width="240" Margin="0,0,8,8" PlaceholderText="Fichiers récents" />
                    <Button x:Name="OpenRecentButton" Margin="0,0,0,8" Click="OpenRecentButton_Click">Ouvrir récent</Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Border x:Name="SupportReminderBorder"
                Grid.Row="1"
                IsVisible="False"
                Background="{DynamicResource PanelAltBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <TextBlock x:Name="SupportReminderText"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="DCE vous fait gagner du temps ? Vous pouvez soutenir son développement, sans aucune obligation." />
                <WrapPanel Grid.Column="1">
                    <Button x:Name="SupportReminderOpenButton"
                            Margin="0,0,8,0"
                            Classes="primary"
                            Click="SupportReminderOpenButton_Click"
                            ToolTip.Tip="Affiche les moyens facultatifs de soutenir le projet.">Soutenir DCE</Button>
                    <Button x:Name="SupportReminderLaterButton"
                            Margin="0,0,8,0"
                            Click="SupportReminderLaterButton_Click"
                            ToolTip.Tip="Masque ce rappel pendant 20 lancements.">Pas maintenant</Button>
                    <Button x:Name="SupportReminderNeverButton"
                            Click="SupportReminderNeverButton_Click"
                            ToolTip.Tip="Désactive définitivement ce rappel local.">Ne plus afficher</Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="200,*">
            <Border x:Name="ProjectSidebar"
                    Grid.Column="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="14">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <StackPanel>
                        <TextBlock Classes="section" Text="Projet" />
                        <TextBlock x:Name="ProjectSummaryText" Classes="muted" Text="Chargez un XML pour commencer." TextWrapping="Wrap" />
                    </StackPanel>

                    <Border x:Name="WarningBorder"
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="10"
                            CornerRadius="5"
                            BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1"
                            IsVisible="False">
                        <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0" Spacing="6">
                        <TextBlock Text="Recherche" FontWeight="SemiBold" />
                        <TextBox x:Name="SearchTextBox" Watermark="Machine ou canal" TextChanged="SearchTextBox_TextChanged" />
                        <ComboBox x:Name="DeviceFilterCombo" SelectionChanged="DeviceFilterCombo_SelectionChanged">
                            <ComboBoxItem Tag="all">Toutes</ComboBoxItem>
                            <ComboBoxItem Tag="modified">Modifiées uniquement</ComboBoxItem>
                            <ComboBoxItem Tag="static">IP fixes</ComboBoxItem>
                            <ComboBoxItem Tag="preferred">Preferred masters</ComboBoxItem>
                            <ComboBoxItem Tag="redundant">Redondantes</ComboBoxItem>
                            <ComboBoxItem Tag="daisychain">Daisychain</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <Border Grid.Row="3" Classes="panel" Margin="0,16,0,0" VerticalAlignment="Top">
                        <TextBlock Classes="muted"
                                   Text="Mode hors ligne : l'application modifie uniquement les fichiers XML chargés. Elle ne se connecte pas au réseau Dante."
                                   TextWrapping="Wrap"
                                   LineHeight="19" />
                    </Border>

                    <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,12,0,0" Spacing="0">
                        <TextBlock Text="By Mamat" HorizontalAlignment="Center" Classes="muted" />
                        <TextBlock Text="et ses agents" HorizontalAlignment="Center" Classes="muted" FontSize="10" />
                        <TextBlock Text="-------[]--" HorizontalAlignment="Center" Classes="muted" FontFamily="Menlo,Consolas,monospace" FontSize="8" Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="MainTabs" Grid.Column="1" Margin="14">
                <TabItem x:Name="ConfigurationTab" Header="Machines">
                    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12" Margin="0,12,0,0">
                        <Border Grid.Row="0" Classes="panel">
                            <Grid ColumnDefinitions="Auto,320,Auto,Auto,*"
                                  ColumnSpacing="8">
                                <TextBlock Text="Banque de machines"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,2,0" />
                                <ComboBox x:Name="MachineBankSourceComboBox"
                                          Grid.Column="1"
                                          SelectionChanged="MachineBankSourceComboBox_SelectionChanged"
                                          ToolTip.Tip="Choisit la banque utilisée par les actions de cette page." />
                                <Button x:Name="AddDeviceFromBankButton"
                                        Grid.Column="2"
                                        Classes="primary"
                                        Click="AddDeviceFromBankButton_Click"
                                        ToolTip.Tip="Ouvre la banque sélectionnée et ajoute une machine indépendante au projet.">
                                    Ajouter depuis la banque
                                </Button>
                                <Button x:Name="ManageMachineBankButton"
                                        Grid.Column="3"
                                        Click="ManageMachineBankButton_Click"
                                        ToolTip.Tip="Consulte et administre la banque sélectionnée.">
                                    Gérer la banque
                                </Button>
                                <TextBlock x:Name="MachineBankSummaryTextBlock"
                                           Grid.Column="4"
                                           Classes="muted"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Text="Chargement des banques de machines..." />
                            </Grid>
                        </Border>

                        <Grid x:Name="ConfigurationEditorsGrid"
                              Grid.Row="1"
                              ColumnDefinitions="1.05*,1.05*,0.9*"
                              ColumnSpacing="12"
                              MinHeight="220"
                              MaxHeight="250">
                            <Border Grid.Column="0" Classes="panel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section" Text="Machine sélectionnée" />
                                        <TextBlock x:Name="SelectedDeviceNameText" FontSize="17" FontWeight="SemiBold" Text="-" />

                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                                                <TextBlock Text="Nouveau nom" Classes="muted" />
                                                <TextBox x:Name="DeviceNameTextBox" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                                                <TextBlock Text="Mode réseau" Classes="muted" />
                                                <ComboBox x:Name="NetworkModeCombo" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                                                <TextBlock Text="Latence unicast" Classes="muted" />
                                                <ComboBox x:Name="LatencyCombo" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                                <TextBlock Text="Sample rate" Classes="muted" />
                                                <ComboBox x:Name="SampleRateCombo" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="3">
                                                <TextBlock Text="Bits par échantillon" Classes="muted" />
                                                <ComboBox x:Name="BitsCombo" />
                                            </StackPanel>
                                            <CheckBox x:Name="PreferredCheckBox" Grid.Row="2" Grid.Column="1" Content="Preferred master" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                            <StackPanel Grid.Row="3" Grid.Column="0" Spacing="3">
                                                <TextBlock Text="Mode IP" Classes="muted" />
                                                <ComboBox x:Name="IpModeCombo" SelectionChanged="IpModeCombo_SelectionChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="3">
                                                <TextBlock Text="Adresse IP" Classes="muted" />
                                                <TextBox x:Name="IpAddressTextBox" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <TextBox x:Name="NetmaskTextBox" Watermark="Masque" />
                                            <TextBox x:Name="GatewayTextBox" Grid.Column="1" Watermark="Passerelle" />
                                        </Grid>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Column="1" Classes="panel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section" Text="Canaux de la machine" />
                                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                                            <ComboBox x:Name="ChannelKindCombo" SelectionChanged="ChannelKindCombo_SelectionChanged">
                                                <ComboBoxItem Tag="tx">TX</ComboBoxItem>
                                                <ComboBoxItem Tag="rx">RX</ComboBoxItem>
                                            </ComboBox>
                                            <ComboBox x:Name="ChannelCombo" Grid.Column="1" SelectionChanged="ChannelCombo_SelectionChanged" />
                                        </Grid>
                                        <TextBox x:Name="ChannelNameTextBox" Watermark="Nouveau nom de canal" />
                                        <Button x:Name="RenameChannelButton" Classes="primary" HorizontalAlignment="Left" Click="RenameChannelButton_Click">Renommer le canal</Button>

                                        <Border Height="1" Background="{DynamicResource PanelBorderBrush}" Margin="0,4" />
                                        <TextBlock Text="Renommage en série" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <ComboBox x:Name="StartChannelCombo" PlaceholderText="Canal début" />
                                            <ComboBox x:Name="EndChannelCombo" Grid.Column="1" PlaceholderText="Canal fin" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,90" ColumnSpacing="8">
                                            <TextBox x:Name="BatchPrefixTextBox" Watermark="Préfixe ou modèle HF {00}" />
                                            <TextBox x:Name="BatchNumberTextBox" Grid.Column="1" Text="1" Watermark="Numéro" />
                                        </Grid>
                                        <Button x:Name="BatchRenameButton" Classes="primary" Click="BatchRenameButton_Click">Renommer la série</Button>
                                        <Button x:Name="ResetDeviceChannelsButton" Click="ResetDeviceChannelsButton_Click">Réinitialiser les canaux de la machine</Button>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Column="2" Classes="panel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section" Text="Actions globales" />
                                        <TabControl>
                                        <TabItem Header="Réseau / audio">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Spacing="7" Margin="0,8,0,0">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <ComboBox x:Name="GlobalNetworkCombo" />
                                                        <Button Grid.Column="1" Click="ApplyGlobalNetworkButton_Click">Appliquer</Button>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <ComboBox x:Name="GlobalLatencyCombo" />
                                                        <Button Grid.Column="1" Click="ApplyGlobalLatencyButton_Click">Appliquer</Button>
                                                    </Grid>
                                                    <Button Click="ResetAllChannelsButton_Click">Réinitialiser tous les canaux</Button>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <ComboBox x:Name="GlobalSampleRateCombo" />
                                                        <Button Grid.Column="1" Click="ApplyGlobalSampleRateButton_Click">Appliquer</Button>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <ComboBox x:Name="GlobalBitsCombo" />
                                                        <Button Grid.Column="1" Click="ApplyGlobalBitsButton_Click">Appliquer</Button>
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabItem>
                                        <TabItem Header="IP">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <Button Click="GlobalIpAutoButton_Click">Mettre toutes les IP en automatique</Button>
                                                <TextBox x:Name="GlobalIpPrefixTextBox" Text="192.168.1" Watermark="Préfixe IP" />
                                                <TextBox x:Name="GlobalIpStartTextBox" Text="10" Watermark="Premier numéro" />
                                                <TextBox x:Name="GlobalNetmaskTextBox" Text="255.255.255.0" Watermark="Masque" />
                                                <TextBox x:Name="GlobalGatewayTextBox" Text="0.0.0.0" Watermark="Passerelle" />
                                                <Button Classes="primary" Click="GlobalStaticIpButton_Click">Fixer les IP en série</Button>
                                            </StackPanel>
                                        </TabItem>
                                        <TabItem Header="Profils">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Profil rapide" Classes="muted" />
                                                <ComboBox x:Name="ProfileCombo" />
                                                <Button Classes="primary" Click="ApplyProfileButton_Click">Appliquer le profil à toutes</Button>
                                            </StackPanel>
                                        </TabItem>
                                        <TabItem Header="Horloge">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Preferred Master à conserver" Classes="muted" />
                                                <ComboBox x:Name="ExclusivePreferredMasterCombo" />
                                                <Button Classes="primary" Click="ApplyExclusivePreferredMasterButton_Click">Conserver un seul Preferred Master</Button>
                                            </StackPanel>
                                        </TabItem>
                                        </TabControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Classes="panel">
                            <WrapPanel Orientation="Horizontal"
                                       HorizontalAlignment="Left">
                                <Button x:Name="ApplyDeviceButton"
                                        Classes="primary"
                                        Margin="0,0,8,8"
                                        Click="ApplyDeviceButton_Click">Appliquer les paramètres</Button>
                                <Button x:Name="DeviceDetailsButton"
                                        Margin="0,0,8,8"
                                        Click="DeviceDetailsButton_Click">Détail machine</Button>
                                <Button x:Name="ResetRxButton"
                                        Margin="0,0,8,8"
                                        Click="ResetRxButton_Click">Reset RX</Button>
                                <Button x:Name="ResetTxButton"
                                        Margin="0,0,8,8"
                                        Click="ResetTxButton_Click">Reset TX</Button>
                                <Button x:Name="ResetRxTxButton"
                                        Margin="0,0,8,8"
                                        Click="ResetRxTxButton_Click">Reset patch RX/TX</Button>
                                <Button x:Name="DeleteDeviceButton"
                                        Classes="danger"
                                        Margin="0,0,8,8"
                                        Click="DeleteDeviceButton_Click">Supprimer</Button>
                                <Button x:Name="DuplicateDeviceButton"
                                        Margin="0,0,8,8"
                                        Click="DuplicateDeviceButton_Click">Dupliquer</Button>
                                <Button x:Name="SaveDeviceToBankButton"
                                        Margin="0,0,8,8"
                                        Click="SaveDeviceToBankButton_Click">Enregistrer dans la banque</Button>
                            </WrapPanel>
                        </Border>

                        <DataGrid x:Name="DeviceGrid"
                                  Grid.Row="3"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  SelectionChanged="DeviceGrid_SelectionChanged"
                                  DoubleTapped="DeviceGrid_DoubleTapped">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Machine" Binding="{Binding Name}" Width="1.5*" />
                                <DataGridTextColumn Header="Friendly name" Binding="{Binding FriendlyName}" Width="1.5*" />
                                <DataGridTextColumn Header="Réseau" Binding="{Binding Network}" Width="*" />
                                <DataGridTextColumn Header="Latence" Binding="{Binding Latency}" Width="*" />
                                <DataGridTextColumn Header="Sample rate" Binding="{Binding SampleRate}" Width="*" />
                                <DataGridTextColumn Header="Bits" Binding="{Binding Bits}" Width="0.7*" />
                                <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="1.5*" />
                                <DataGridCheckBoxColumn Header="Preferred" Binding="{Binding PreferredMaster}" Width="0.8*" />
                                <DataGridTextColumn Header="TX" Binding="{Binding Tx}" Width="0.6*" />
                                <DataGridTextColumn Header="RX" Binding="{Binding Rx}" Width="0.6*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="PatchTab" Header="Patch">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,12,0,0">
                        <Border Classes="panel">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock x:Name="PatchListHeading"
                                                   Text="Liste RX vers TX"
                                                   FontSize="17"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="PatchListDescription"
                                                   Classes="muted"
                                                   Text="Consultez chaque RX et sa source actuelle, ou ouvrez l’atelier pour patcher dans la matrice."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="VisualPatchButton"
                                            Grid.Column="1"
                                            Classes="primary"
                                            VerticalAlignment="Center"
                                            Click="VisualPatchButton_Click"
                                            ToolTip.Tip="Ouvre Easy patch et la matrice. Chaque action y est appliquée immédiatement.">
                                        Easy patch / Matrice
                                    </Button>
                                </Grid>
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="1.2*,0.9*,1.35*,1.35*,Auto,Auto"
                                      ColumnSpacing="8">
                                    <TextBox x:Name="PatchSearchTextBox"
                                             Watermark="Recherche device ou canal"
                                             TextChanged="PatchSearchTextBox_TextChanged" />
                                    <ComboBox x:Name="PatchStatusCombo"
                                              Grid.Column="1"
                                              SelectionChanged="PatchStatusCombo_SelectionChanged">
                                        <ComboBoxItem Tag="all">Tous les RX</ComboBoxItem>
                                        <ComboBoxItem Tag="active">Patchs actifs</ComboBoxItem>
                                        <ComboBoxItem Tag="free">RX libres</ComboBoxItem>
                                        <ComboBoxItem Tag="warnings">Warnings / conflits</ComboBoxItem>
                                    </ComboBox>
                                    <ComboBox x:Name="SourceDeviceCombo"
                                              Grid.Column="2"
                                              PlaceholderText="Source TX à appliquer"
                                              SelectionChanged="SourceDeviceCombo_SelectionChanged" />
                                    <ComboBox x:Name="SourceChannelCombo"
                                              Grid.Column="3"
                                              PlaceholderText="Canal TX à appliquer" />
                                    <Button x:Name="ApplyPatchButton"
                                            Grid.Column="4"
                                            Classes="primary"
                                            Click="ApplyPatchButton_Click"
                                            ToolTip.Tip="Affecte immédiatement la source TX choisie au RX sélectionné.">
                                        Appliquer
                                    </Button>
                                    <Button x:Name="RemovePatchButton"
                                            Grid.Column="5"
                                            Click="RemovePatchButton_Click"
                                            ToolTip.Tip="Déconnecte immédiatement le RX sélectionné.">
                                        Supprimer
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="PatchGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="RX device" Binding="{Binding RxDevice}" Width="1.2*" />
                                <DataGridTextColumn Header="RX Dante Id" Binding="{Binding RxDanteId}" Width="0.85*" />
                                <DataGridTextColumn Header="RX canal" Binding="{Binding RxChannel}" Width="1.2*" />
                                <DataGridTextColumn Header="TX device" Binding="{Binding TxDevice}" Width="1.2*" />
                                <DataGridTextColumn Header="TX canal" Binding="{Binding TxChannel}" Width="1.2*" />
                                <DataGridTextColumn Header="Source complète" Binding="{Binding Source}" Width="1.5*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                                <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="1.35*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ExportsTab" Header="Import / Export">
                    <TabControl Margin="0,8,0,0">
                        <TabItem x:Name="ChannelLabelsTab" Header="Labels">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16" Margin="0,12,0,0">
                        <Border Classes="panel">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Import et export de labels"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Labels JSON/CSV, DMT XLSX/ODS, A&amp;H dLive/Avantis et Yamaha CL/QL."
                                           Classes="muted" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="20"
                              MaxWidth="1100"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Border Classes="panel">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Importer des labels" Classes="section" />
                                    <TextBlock Text="Importez des labels JSON/CSV, DMT XLSX/ODS, A&amp;H CSV ou Yamaha CL/QL ZIP/CSV."
                                               Classes="muted"
                                               TextWrapping="Wrap" />
                                    <Button x:Name="ImportChannelLabelsButton"
                                            Classes="primary"
                                            HorizontalAlignment="Stretch"
                                            Click="ImportChannelLabelsButton_Click"
                                            ToolTip.Tip="Détecte les formats génériques, DMT, A&amp;H et Yamaha, puis prévisualise les labels avant de les appliquer aux machines Dante.">Importer des labels</Button>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="panel">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Exporter des labels" Classes="section" />
                                    <TextBlock Text="Exportez en générique ou créez une copie d'un modèle DMT, A&amp;H ou Yamaha."
                                               Classes="muted"
                                               TextWrapping="Wrap" />
                                    <Button x:Name="ExportChannelLabelsButton"
                                            HorizontalAlignment="Stretch"
                                            Click="ExportChannelLabelsButton_Click"
                                            ToolTip.Tip="Exporte les labels TX/RX et ne modifie jamais les modèles DMT, A&amp;H ou Yamaha originaux.">Exporter des labels</Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button x:Name="OpenDmtProjectButton"
                                Grid.Row="2"
                                HorizontalAlignment="Center"
                                Click="OpenDmtProjectButton_Click"
                                ToolTip.Tip="Ouvre la page GitHub de dLive MIDI Tools par togrupe, dont les modèles dLive et Avantis sont compatibles.">Compatibilité DMT dLive / Avantis - ouvrir le projet</Button>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="ReportsExportTab" Header="Rapports et patchbook">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,12,0,0">
                                <Border Classes="panel">
                                    <StackPanel>
                                        <TextBlock Text="Rapports du projet" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Exportez un résumé lisible de la configuration chargée."
                                                   Classes="muted"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,14" />
                                        <Button Content="Exporter TXT" Click="ExportTxtButton_Click" />
                                        <Button Content="Exporter PDF" Click="ExportPdfButton_Click" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="panel">
                                    <StackPanel>
                                        <TextBlock Text="Patchbook" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Exportez les affectations de patch au format TXT ou CSV."
                                                   Classes="muted"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,14" />
                                        <Button Content="Patchbook TXT" Click="PatchbookTxtButton_Click" />
                                        <Button Content="Patchbook CSV" Click="PatchbookCsvButton_Click" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="panel">
                                    <StackPanel>
                                        <TextBlock Text="Analyse simple" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Créez une vue textuelle compacte des liaisons entre machines."
                                                   Classes="muted"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,14" />
                                        <Button Content="Topologie simple" Click="TopologyButton_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="SynopticTab" Header="Synoptique">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="0,12,0,0">
                        <Border Classes="panel">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Synoptique visuel" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Machines regroupées par emplacement et patchs consécutifs réunis sur un même câble."
                                               Classes="muted" />
                                </StackPanel>
                                <TextBlock x:Name="SynopticSummaryText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Classes="muted"
                                           Text="Aucun fichier chargé." />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="400,12,*">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <Border Classes="panel">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                                        <TextBlock Text="Emplacement de la sélection" FontWeight="SemiBold" />
                                        <Grid Grid.Row="1" ColumnDefinitions="*,150,Auto" ColumnSpacing="8">
                                            <TextBox x:Name="SynopticLocationTextBox"
                                                     Watermark="Scène, Régie, Studio A…" />
                                            <ComboBox x:Name="SynopticKnownLocationComboBox"
                                                      Grid.Column="1"
                                                      SelectionChanged="SynopticKnownLocationComboBox_SelectionChanged"
                                                      ToolTip.Tip="Zones déjà utilisées" />
                                            <Button x:Name="ApplySynopticLocationButton"
                                                    Grid.Column="2"
                                                    Classes="primary"
                                                    Click="ApplySynopticLocationButton_Click">Affecter</Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <DataGrid x:Name="SynopticDeviceGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          SelectionMode="Extended"
                                          CellEditEnded="SynopticDeviceGrid_CellEditEnded">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Voir" Width="54">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Click="SynopticVisibilityCheckBox_Click" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Machine" Binding="{Binding DeviceName}" IsReadOnly="True" Width="1.3*" />
                                        <DataGridTextColumn Header="Emplacement" Binding="{Binding Location, Mode=TwoWay}" Width="1.2*" />
                                        <DataGridTextColumn Header="Ordre" Binding="{Binding Order, Mode=TwoWay}" Width="70" />
                                        <DataGridTextColumn Header="TX/RX" Binding="{Binding ChannelCount}" IsReadOnly="True" Width="72" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <Border Grid.Column="2"
                                    Background="#F7F9FC"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid RowDefinitions="Auto,*">
                                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="8,6">
                                        <TextBlock Text="Zoom" VerticalAlignment="Center" />
                                        <Button Width="34" Click="ZoomOutSynopticButton_Click" ToolTip.Tip="Zoom arrière">−</Button>
                                        <Slider x:Name="SynopticZoomSlider"
                                                Width="150"
                                                Minimum="0.1"
                                                Maximum="2.5"
                                                Value="1"
                                                ValueChanged="SynopticZoomSlider_ValueChanged" />
                                        <Button Width="34" Click="ZoomInSynopticButton_Click" ToolTip.Tip="Zoom avant">+</Button>
                                        <TextBlock x:Name="SynopticZoomText" Width="58" Text="100 %" TextAlignment="Center" VerticalAlignment="Center" />
                                        <Button Click="ResetSynopticZoomButton_Click">100 %</Button>
                                        <Button Click="FitSynopticZoomButton_Click">Ajuster</Button>
                                        <Button x:Name="OpenSynopticPreviewWindowButton"
                                                Width="36"
                                                ToolTip.Tip="Ouvrir l’aperçu dans une fenêtre séparée"
                                                Click="OpenSynopticPreviewWindowButton_Click">↗</Button>
                                    </StackPanel>
                                    <ScrollViewer x:Name="SynopticScrollViewer"
                                                  Grid.Row="1"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  PointerWheelChanged="SynopticScrollViewer_PointerWheelChanged">
                                        <LayoutTransformControl x:Name="SynopticZoomHost">
                                            <Canvas x:Name="SynopticCanvas"
                                                    Width="900"
                                                    Height="560"
                                                    Background="#F7F9FC" />
                                        </LayoutTransformControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ShowAllSynopticDevicesButton" Click="ShowAllSynopticDevicesButton_Click">Tout afficher</Button>
                                <Button x:Name="HideSelectedSynopticDevicesButton" Click="HideSelectedSynopticDevicesButton_Click">Masquer sélection</Button>
                                <Button x:Name="MoveSynopticDeviceUpButton" Width="42" Click="MoveSynopticDeviceUpButton_Click" ToolTip.Tip="Place la machine plus haut.">↑</Button>
                                <Button x:Name="MoveSynopticDeviceDownButton" Width="42" Click="MoveSynopticDeviceDownButton_Click" ToolTip.Tip="Place la machine plus bas.">↓</Button>
                                <Button x:Name="ResetSynopticLayoutButton" Click="ResetSynopticLayoutButton_Click">Disposition automatique</Button>
                            </StackPanel>
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right">
                                <CheckBox x:Name="OpenSynopticAfterExportCheckBox"
                                          Content="Ouvrir après export"
                                          IsChecked="True"
                                          VerticalAlignment="Center" />
                                <Button x:Name="RefreshSynopticButton" Click="RefreshSynopticButton_Click">Actualiser l’aperçu</Button>
                                <Button x:Name="ExportSynopticButton" Classes="primary" Click="ExportSynopticButton_Click">Exporter le synoptique SVG</Button>
                                <Button x:Name="ExportSynopticPdfButton" Classes="primary" Click="ExportSynopticPdfButton_Click">Exporter le synoptique PDF</Button>
                            </StackPanel>
                        </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem x:Name="HealthTab" Header="Centre de validation">
                    <TabControl x:Name="ValidationTabs" Margin="0,8,0,0">
                        <TabItem x:Name="ValidationIssuesTab" Header="Points à vérifier">
                            <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,12,0,0">
                                <Border Classes="panel">
                                    <TextBlock x:Name="HealthSummaryText"
                                               Text="Aucun fichier chargé."
                                               TextWrapping="Wrap" />
                                </Border>
                                <DataGrid x:Name="HealthGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Gravité" Binding="{Binding Severity}" Width="0.8*" />
                                        <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="*" />
                                        <DataGridTextColumn Header="Machine" Binding="{Binding Device}" Width="1.1*" />
                                        <DataGridTextColumn Header="Canal" Binding="{Binding Channel}" Width="1.1*" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="3*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="ValidationReportsTab" Header="Rapports">
                            <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,12,0,0">
                                <Border Classes="panel">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Margin="0,0,8,8"
                                                Classes="primary"
                                                Click="ValidateButton_Click"
                                                ToolTip.Tip="Vérifie la structure et les références du XML chargé.">
                                            Vérifier le fichier
                                        </Button>
                                        <Button Margin="0,0,8,8"
                                                Click="CompatibilityButton_Click"
                                                ToolTip.Tip="Prépare un rapport de compatibilité à relire avant l’import dans Dante Controller.">
                                            Rapport compatibilité Dante Controller
                                        </Button>
                                        <Button Margin="0,0,8,8"
                                                Click="FinalReportButton_Click"
                                                ToolTip.Tip="Résume les machines, formats, adresses et points de vigilance.">
                                            Rapport final avant Dante
                                        </Button>
                                        <Button Margin="0,0,8,8"
                                                Click="CompareButton_Click"
                                                ToolTip.Tip="Compare le projet avec un autre fichier XML sans modifier aucun des deux.">
                                            Comparer XML
                                        </Button>
                                    </WrapPanel>
                                </Border>
                                <TextBox x:Name="ReportTextBox"
                                         Grid.Row="1"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Menlo,Consolas,monospace"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem x:Name="SafetyTab" Header="Historique">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,12,0,0">
                        <Border Classes="panel">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Historique des actions"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Les dernières modifications de cette session sont affichées ci-dessous."
                                               Classes="muted"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1"
                                           Orientation="Horizontal"
                                           VerticalAlignment="Center">
                                    <Button Margin="0,0,8,0"
                                            Click="QuickStartButton_Click"
                                            ToolTip.Tip="Ouvre la notice rapide PDF.">
                                        Quick start
                                    </Button>
                                    <Button Margin="0,0,8,0"
                                            Click="FullGuideButton_Click"
                                            ToolTip.Tip="Ouvre la notice complète PDF.">
                                        Notice complète
                                    </Button>
                                    <Button x:Name="SupportDceButton"
                                            Margin="0,0,8,0"
                                            Click="SupportDceButton_Click"
                                            ToolTip.Tip="Présente les moyens facultatifs de soutenir ce projet gratuit.">
                                        Soutenir DCE
                                    </Button>
                                    <Button x:Name="OpenDiagnosticLogsButton"
                                            Click="OpenDiagnosticLogsButton_Click"
                                            ToolTip.Tip="Ouvre le dossier des journaux techniques utiles au diagnostic.">
                                        Ouvrir les journaux
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Classes="panel">
                            <ListBox x:Name="LogListBox" />
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="AtomicTab" Header="Outils avancés">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid MinWidth="980"
                              MaxWidth="1120"
                              HorizontalAlignment="Left"
                              Margin="18"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="12">
                            <Border Grid.Row="0"
                                    Padding="20,16"
                                    Background="#2B1114"
                                    BorderBrush="#8B1A1A"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                    <StackPanel>
                                        <TextBlock Text="ATOMIC BOMB"
                                                   Foreground="White"
                                                   FontSize="24"
                                                   FontWeight="Bold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   MaxWidth="760"
                                                   Foreground="#FECACA"
                                                   TextWrapping="Wrap"
                                                   Text="Générateur d'expérience horrible, mais pédagogique. Le projet chargé devient une copie d'exercice volontairement chaotique." />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="14,8"
                                            VerticalAlignment="Center"
                                            Background="#111827"
                                            BorderBrush="#64748B"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock x:Name="AtomicPanelStatusTextBlock"
                                                   Text="SAFE · Tournez la clé"
                                                   Foreground="#94A3B8"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1"
                                  ColumnDefinitions="440,12,*">
                                <Border x:Name="AtomicOptionsBorder"
                                        Grid.Column="0"
                                        Padding="18"
                                        Background="#24181D"
                                        BorderBrush="#5F3036"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="PÉRIMÈTRE DE L'EXERCICE"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   FontWeight="Bold" />
                                        <TextBlock Foreground="#FECACA"
                                                   TextWrapping="Wrap"
                                                   Text="Décochez les catégories qui doivent rester intactes." />
                                        <Grid ColumnDefinitions="*,*"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                              ColumnSpacing="18"
                                              RowSpacing="5">
                                            <CheckBox x:Name="AtomicDeviceNamesCheckBox" Content="Noms des machines" IsChecked="True" Foreground="White" />
                                            <CheckBox x:Name="AtomicTxLabelsCheckBox" Grid.Column="1" Content="Labels des canaux TX" IsChecked="True" Foreground="White" />
                                            <CheckBox x:Name="AtomicRxLabelsCheckBox" Grid.Row="1" Content="Labels des canaux RX" IsChecked="True" Foreground="White" />
                                            <CheckBox x:Name="AtomicPatchesCheckBox" Grid.Row="1" Grid.Column="1" Content="Patchs / subscriptions" IsChecked="True" Foreground="White" />
                                            <CheckBox x:Name="AtomicNetworkModeCheckBox" Grid.Row="2" Content="Modes réseau" IsChecked="True" Foreground="White" />
                                            <CheckBox x:Name="AtomicPreferredMasterCheckBox" Grid.Row="2" Grid.Column="1" Content="Preferred Master" IsChecked="True" Foreground="White" />
                                            <CheckBox x:Name="AtomicLatencyCheckBox" Grid.Row="3" Content="Latences" IsChecked="True" Foreground="White" />
                                            <CheckBox x:Name="AtomicSampleRateCheckBox" Grid.Row="3" Grid.Column="1" Content="Fréquences d'échantillonnage" IsChecked="True" Foreground="White" />
                                            <CheckBox x:Name="AtomicEncodingCheckBox" Grid.Row="4" Content="Bits par échantillon" IsChecked="True" Foreground="White" />
                                            <CheckBox x:Name="AtomicIpCheckBox" Grid.Row="4" Grid.Column="1" Content="IP principales" IsChecked="True" Foreground="White" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Padding="18"
                                        Background="#111827"
                                        BorderBrush="#64748B"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
                                        <TextBlock Text="PUPITRE DE COMMANDE"
                                                   Foreground="#CBD5E1"
                                                   FontSize="16"
                                                   FontWeight="Bold" />
                                        <Grid Grid.Row="1"
                                              ColumnDefinitions="170,14,*">
                                            <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Spacing="6">
                                                <TextBlock Text="AUTORISATION"
                                                           Foreground="#94A3B8"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center" />
                                                <Button x:Name="AtomicKeyButton"
                                                        Classes="atomicSequence"
                                                        Click="AtomicKeyButton_Click"
                                                        ToolTip.Tip="Tourne la clé de 90 degrés et ouvre automatiquement le capot. Un second clic remet le pupitre en sécurité.">
                                                    <Grid ColumnDefinitions="54,*">
                                                        <Grid x:Name="AtomicKeyVisual"
                                                              Width="48"
                                                              Height="48"
                                                              VerticalAlignment="Center"
                                                              RenderTransformOrigin="50%,50%">
                                                            <Ellipse Width="46"
                                                                     Height="46"
                                                                     Fill="#111827"
                                                                     Stroke="#94A3B8"
                                                                     StrokeThickness="2" />
                                                            <Rectangle Width="12"
                                                                       Height="34"
                                                                       RadiusX="4"
                                                                       RadiusY="4"
                                                                       Fill="#D1D5DB"
                                                                       Stroke="#4B5563"
                                                                       StrokeThickness="1" />
                                                            <Rectangle Width="20"
                                                                       Height="8"
                                                                       Margin="0,0,0,20"
                                                                       RadiusX="3"
                                                                       RadiusY="3"
                                                                       Fill="#E5E7EB" />
                                                            <Ellipse Width="7"
                                                                     Height="7"
                                                                     Fill="#374151" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock x:Name="AtomicKeyTitleTextBlock"
                                                                       Text="1. CLÉ"
                                                                       Foreground="White"
                                                                       FontWeight="Bold" />
                                                            <TextBlock x:Name="AtomicKeyPositionTextBlock"
                                                                       Text="OFF · verticale"
                                                                       Foreground="#CBD5E1"
                                                                       FontSize="11" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="AtomicPanelResetButton"
                                                        Content="RETOUR SAFE"
                                                        Click="AtomicPanelResetButton_Click"
                                                        ToolTip.Tip="Annule la séquence sans modifier le projet." />
                                            </StackPanel>

                                            <Grid Grid.Column="2">
                                                <Border Background="#1F2937"
                                                        BorderBrush="#475569"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="12">
                                                    <Grid x:Name="AtomicButtonDeck"
                                                          ColumnDefinitions="*,*,*"
                                                          ColumnSpacing="8">
                                                        <Button x:Name="AtomicArmButton"
                                                                Grid.Column="0"
                                                                Classes="atomicSequence"
                                                                MinWidth="108"
                                                                Content="ARM"
                                                                IsEnabled="False"
                                                                Click="AtomicArmButton_Click"
                                                                ToolTip.Tip="Arme la copie de travail sans encore la modifier." />
                                                        <Button x:Name="AtomicLockButton"
                                                                Grid.Column="1"
                                                                Classes="atomicSequence"
                                                                MinWidth="108"
                                                                Content="LOCK"
                                                                IsEnabled="False"
                                                                Click="AtomicLockButton_Click"
                                                                ToolTip.Tip="Verrouille les options choisies et autorise FIRE." />
                                                        <Button x:Name="AtomicChaosButton"
                                                                Grid.Column="2"
                                                                Classes="atomic"
                                                                HorizontalAlignment="Center"
                                                                Background="#4B1D22"
                                                                Content="FIRE"
                                                                IsEnabled="False"
                                                                Click="AtomicChaosButton_Click"
                                                                ToolTip.Tip="Déclenche immédiatement l'exercice hors ligne lorsque ARM et LOCK sont actifs." />
                                                    </Grid>
                                                </Border>

                                                <Border x:Name="AtomicSafetyCover"
                                                        MinHeight="154"
                                                        Background="#D934171B"
                                                        BorderBrush="#EF4444"
                                                        BorderThickness="3"
                                                        CornerRadius="4"
                                                        ToolTip.Tip="La clé ouvre ce capot et révèle ARM, LOCK et FIRE.">
                                                    <StackPanel>
                                                        <TextBlock x:Name="AtomicCoverTitleTextBlock"
                                                                   Text="2. CAPOT DE SÉCURITÉ"
                                                                   Foreground="#FECACA"
                                                                   FontSize="17"
                                                                   FontWeight="Bold"
                                                                   TextAlignment="Center" />
                                                        <TextBlock x:Name="AtomicCoverHintTextBlock"
                                                                   Text="VERROUILLÉ · tourner la clé pour ouvrir"
                                                                   Foreground="#FECACA"
                                                                   TextAlignment="Center"
                                                                   Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2"
                                    Padding="14,10"
                                    Background="#3A171B"
                                    BorderBrush="#7F1D1D"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <TextBlock Foreground="#FCA5A5"
                                           MaxWidth="1040"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Text="Séquence : tournez la clé de 90° vers la droite pour ouvrir le capot → ARM → LOCK → FIRE. FIRE agit immédiatement, sans dialogue supplémentaire. Le XML original reste intact tant que vous n'écrasez pas volontairement son fichier." />
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBlock x:Name="StatusText" Text="Prêt" />
                <TextBlock x:Name="ModeText" Grid.Column="1" Text="Mode : Lecture seule" Classes="muted" />
                <TextBlock x:Name="CountText" Grid.Column="2" Text="0 device - 0 TX - 0 RX" Classes="muted" />
            </Grid>
        </Border>
    </Grid>
</Window>
