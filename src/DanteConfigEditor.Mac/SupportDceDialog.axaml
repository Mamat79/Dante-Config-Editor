<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DanteConfigEditor.Mac.SupportDceDialog"
        Width="700"
        Height="700"
        MinWidth="600"
        MinHeight="620"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="18">
        <StackPanel Spacing="6">
            <TextBlock x:Name="TitleText"
                       FontSize="24"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="SubtitleText"
                       Classes="muted"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Classes="panel" Padding="18">
            <Grid ColumnDefinitions="300,24,*">
                <Border Grid.Column="0"
                        Width="300"
                        Height="300"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1">
                    <Image Source="avares://DanteConfigEditorV3.Mac/Assets/paypal-support-qr.png"
                           Width="300"
                           Height="300"
                           Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="14">
                    <TextBlock x:Name="FreeText"
                               FontSize="15"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SupportText"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="OtherWaysText"
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button x:Name="PayPalMeButton"
                    Classes="primary"
                    MinWidth="220"
                    MinHeight="38"
                    Click="PayPalMeButton_Click" />
            <Button x:Name="CloseButton"
                    MinWidth="100"
                    MinHeight="38"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
