<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DanteConfigEditor.Mac.MachineCloneDialog"
        Width="700"
        Height="620"
        MinWidth="560"
        MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <StackPanel Spacing="6" Margin="0,0,0,14">
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="IntroText" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="NameLabel" />
                    <TextBox x:Name="NameTextBox" />
                    <TextBlock x:Name="NameHintText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <Border Classes="panel">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="LabelsHeading" FontWeight="SemiBold" />
                        <CheckBox x:Name="PreserveTxLabelsCheckBox" IsChecked="True" />
                        <CheckBox x:Name="PreserveRxLabelsCheckBox" IsChecked="True" />
                    </StackPanel>
                </Border>

                <Border Classes="panel">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SettingsHeading" FontWeight="SemiBold" />
                        <CheckBox x:Name="PreserveSettingsCheckBox" IsChecked="True" />
                        <CheckBox x:Name="PreservePreferredMasterCheckBox" />
                    </StackPanel>
                </Border>

                <Border Classes="panel">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="AdvancedHeading" FontWeight="SemiBold" />
                        <CheckBox x:Name="PreserveNetworkCheckBox" />
                        <CheckBox x:Name="PreserveSubscriptionsCheckBox" />
                        <CheckBox x:Name="PreserveFlowsCheckBox" />
                        <TextBlock x:Name="AdvancedWarningText"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10">
                    <TextBlock x:Name="IdentityNoticeText" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button x:Name="CancelButton" MinWidth="100" Click="CancelButton_Click" />
            <Button x:Name="DuplicateButton" Classes="primary" MinWidth="120" Click="DuplicateButton_Click" />
        </StackPanel>
    </Grid>
</Window>
