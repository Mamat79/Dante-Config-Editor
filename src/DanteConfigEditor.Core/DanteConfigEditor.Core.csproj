<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>DanteConfigEditor.Core</AssemblyName>
    <RootNamespace>DanteConfigEditor</RootNamespace>
    <Version>3.6.1</Version>
    <AssemblyVersion>3.6.1.0</AssemblyVersion>
    <FileVersion>3.6.1.0</FileVersion>
    <InformationalVersion>3.6.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Le coeur macOS compile les mêmes sources métier que l'application Windows. -->
    <Compile Include="..\..\Models\**\*.cs" Link="Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Services\**\*.cs" Link="Services\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Resources\ChannelLabelTemplates\*.xlsx;..\..\Resources\ChannelLabelTemplates\*.ods;..\..\Resources\ChannelLabelTemplates\*.csv;..\..\Resources\ChannelLabelTemplates\*.zip">
      <LogicalName>DanteConfigEditor.ChannelLabelTemplates.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
