<Window x:Class="DanteConfigEditor.MachineTemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modèle de machine"
        Width="860"
        Height="760"
        MinWidth="700"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingTextBlock"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="IntroTextBlock"
                       Margin="0,6,0,14"
                       Foreground="{DynamicResource DialogMutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,14,0">
                    <Label x:Name="TemplateNameLabel" Content="Nom du modèle" />
                    <TextBox x:Name="TemplateNameTextBox" MaxLength="120" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <Label x:Name="ManufacturerLabel" Content="Fabricant" />
                            <TextBox x:Name="ManufacturerTextBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <Label x:Name="ModelLabel" Content="Modèle" />
                            <TextBox x:Name="ModelTextBox" />
                        </StackPanel>
                    </Grid>

                    <Label x:Name="CategoryLabel" Margin="0,10,0,0" Content="Catégorie" />
                    <TextBox x:Name="CategoryTextBox" />
                    <Label x:Name="TagsLabel" Margin="0,10,0,0" Content="Tags" />
                    <TextBox x:Name="TagsTextBox" />
                    <TextBlock x:Name="TagsHintTextBlock"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource DialogMutedBrush}" />

                    <Label x:Name="DescriptionLabel" Margin="0,10,0,0" Content="Description" />
                    <TextBox x:Name="DescriptionTextBox"
                             Height="100"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />

                    <Label x:Name="ImageLabel" Margin="0,10,0,0" Content="Image facultative" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ImagePathTextBox" IsReadOnly="True" />
                        <Button x:Name="BrowseImageButton"
                                Grid.Column="1"
                                Content="Choisir"
                                Margin="8,0,0,0"
                                Click="BrowseImageButton_Click" />
                    </Grid>
                    <CheckBox x:Name="RemoveImageCheckBox"
                              Content="Retirer l'image existante"
                              Visibility="Collapsed" />
                    <Border Height="130"
                            Margin="0,8,0,0"
                            BorderBrush="{DynamicResource DialogBorderBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource DialogSurfaceBrush}">
                        <Image x:Name="ImagePreview"
                               Stretch="Uniform"
                               Margin="6" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="LabelsHeadingTextBlock"
                               FontWeight="SemiBold"
                               FontSize="15" />
                    <TextBlock x:Name="LabelsIntroTextBlock"
                               Margin="0,4,0,10"
                               Foreground="{DynamicResource DialogMutedBrush}"
                               TextWrapping="Wrap" />
                    <TabControl Height="480">
                        <TabItem x:Name="RxTabItem" Header="RX">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="RxLabelsGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#"
                                                            Binding="{Binding Number}"
                                                            IsReadOnly="True"
                                                            Width="54" />
                                        <DataGridTextColumn x:Name="RxLabelColumn"
                                                            Header="Label RX"
                                                            Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button x:Name="GenerateRxButton"
                                        Grid.Row="1"
                                        Content="Générer RX 1, RX 2..."
                                        Style="{StaticResource DialogSecondaryButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Click="GenerateRxButton_Click" />
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="TxTabItem" Header="TX">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="TxLabelsGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#"
                                                            Binding="{Binding Number}"
                                                            IsReadOnly="True"
                                                            Width="54" />
                                        <DataGridTextColumn x:Name="TxLabelColumn"
                                                            Header="Label TX"
                                                            Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button x:Name="GenerateTxButton"
                                        Grid.Row="1"
                                        Content="Générer TX 1, TX 2..."
                                        Style="{StaticResource DialogSecondaryButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Click="GenerateTxButton_Click" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="SaveButton"
                    Content="Enregistrer"
                    IsDefault="True"
                    Click="SaveButton_Click" />
            <Button x:Name="CancelButton"
                    Content="Annuler"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
