<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DanteConfigEditorV3</AssemblyName>
    <RootNamespace>DanteConfigEditor</RootNamespace>
    <ApplicationIcon>DanteEdit.ico</ApplicationIcon>
    <Version>2026.1.1</Version>
    <AssemblyVersion>2026.1.1.0</AssemblyVersion>
    <FileVersion>2026.1.1.0</FileVersion>
    <InformationalVersion>2026.1.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="DanteEdit.ico" />
    <Resource Include="DanteEdit.ico" />
    <Resource Include="Resources\Support\paypal-support-qr.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\ChannelLabelTemplates\*.xlsx;Resources\ChannelLabelTemplates\*.ods;Resources\ChannelLabelTemplates\*.csv;Resources\ChannelLabelTemplates\*.zip">
      <LogicalName>DanteConfigEditor.ChannelLabelTemplates.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <None Update="Resources\ChannelLabelTemplates\DMT_LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tmp\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="benchmarks\**\*.cs" />
    <Compile Remove="src\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Services\**\*.cs" />
    <None Remove="tmp\**\*" />
    <None Remove="tools\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows et macOS consomment désormais le même assemblage métier. -->
    <ProjectReference Include="src\DanteConfigEditor.Core\DanteConfigEditor.Core.csproj" />
    <ProjectReference Include="src\DanteConfigEditor.Domain\DanteConfigEditor.Domain.csproj" />
    <ProjectReference Include="src\DanteConfigEditor.Application\DanteConfigEditor.Application.csproj" />
    <ProjectReference Include="src\DanteConfigEditor.Infrastructure\DanteConfigEditor.Infrastructure.csproj" />
  </ItemGroup>
</Project>
