<Window x:Class="DanteConfigEditor.MachineInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter une machine"
        Width="590"
        Height="585"
        MinWidth="500"
        MinHeight="440"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingTextBlock"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="TemplateSummaryTextBlock"
                       Margin="0,6,0,14"
                       Foreground="{DynamicResource DialogMutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <Label x:Name="NameLabel" Content="Nom de la nouvelle machine" />
                <TextBox x:Name="NameTextBox"
                         MaxLength="31"
                         TextChanged="InstancePreviewChanged" />
                <TextBlock x:Name="NameHintTextBlock"
                           Margin="0,5,0,14"
                           FontSize="12"
                           Foreground="{DynamicResource DialogMutedBrush}"
                           TextWrapping="Wrap" />

                <Grid x:Name="QuantityPanel" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label x:Name="QuantityLabel"
                           VerticalAlignment="Center"
                           Content="Nombre de machines" />
                    <TextBox x:Name="QuantityTextBox"
                             Grid.Column="1"
                             Margin="10,0,0,0"
                             Text="1"
                             TextChanged="InstancePreviewChanged" />
                    <TextBlock x:Name="NamesPreviewTextBlock"
                               Grid.Column="2"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DialogMutedBrush}"
                               TextWrapping="Wrap" />
                </Grid>

                <GroupBox x:Name="RxGroupBox" Header="Canaux RX">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="UseRxLabelsCheckBox"
                                  Content="Utiliser les labels du modèle"
                                  IsChecked="True"
                                  Checked="LabelModeChanged"
                                  Unchecked="LabelModeChanged" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <Label x:Name="RxPrefixLabel" Content="Préfixe numéroté" />
                            <TextBox x:Name="RxPrefixTextBox" Text="RX" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox x:Name="TxGroupBox" Header="Canaux TX">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="UseTxLabelsCheckBox"
                                  Content="Utiliser les labels du modèle"
                                  IsChecked="True"
                                  Checked="LabelModeChanged"
                                  Unchecked="LabelModeChanged" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <Label x:Name="TxPrefixLabel" Content="Préfixe numéroté" />
                            <TextBox x:Name="TxPrefixTextBox" Text="TX" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <TextBlock x:Name="SafetyTextBlock"
                           Foreground="{DynamicResource DialogMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="ConfirmButton"
                    Content="Ajouter au projet"
                    IsDefault="True"
                    Click="ConfirmButton_Click" />
            <Button x:Name="CancelButton"
                    Content="Annuler"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
