<Window x:Class="DanteConfigEditor.SupportDceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soutenir DCE"
        Width="620"
        Height="440"
        MinWidth="520"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogWindowBrush" Color="#10141F" />
        <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#171D2B" />
        <SolidColorBrush x:Key="DialogTextBrush" Color="#F6F8FB" />
        <SolidColorBrush x:Key="DialogMutedBrush" Color="#AAB4C5" />
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#334057" />
        <SolidColorBrush x:Key="DialogAccentBrush" Color="#2F80ED" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DialogSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleTextBlock"
                       Text="Soutenir DCE"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleTextBlock"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource DialogMutedBrush}"
                       Text="Un geste entièrement facultatif pour accompagner ce projet gratuit." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,18"
                Padding="18"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource DialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="FreeTextBlock"
                           Text="Dante Config Editor reste entièrement gratuit et toutes ses fonctions sont disponibles sans contribution."
                           FontSize="15" />
                <TextBlock x:Name="SupportTextBlock"
                           Margin="0,14,0,0"
                           Text="Si DCE vous fait gagner du temps, vous pouvez soutenir son développement par PayPal. La page sécurisée s’ouvrira dans votre navigateur habituel." />
                <TextBlock x:Name="OtherWaysTextBlock"
                           Margin="0,14,0,0"
                           Foreground="{DynamicResource DialogMutedBrush}"
                           Text="Vous pouvez aussi aider gratuitement en ajoutant une étoile au projet GitHub ou en partageant un retour. Et si vous êtes vraiment fous, vous pouvez même faire les deux !" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PayPalButton"
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    Background="{DynamicResource DialogAccentBrush}"
                    Foreground="White"
                    BorderBrush="{DynamicResource DialogAccentBrush}"
                    Content="Soutenir avec PayPal"
                    Click="PayPalButton_Click"
                    AutomationProperties.Name="Soutenir DCE avec PayPal"
                    AutomationProperties.HelpText="Ouvre la page PayPal dans le navigateur par défaut." />
            <Button x:Name="CloseButton"
                    Grid.Column="2"
                    Content="Fermer"
                    IsCancel="True"
                    AutomationProperties.Name="Fermer la fenêtre de soutien" />
        </Grid>
    </Grid>
</Window>
